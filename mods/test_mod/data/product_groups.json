{
  // A goods group lists the products that exist. "papyrus" and "glass_bottle" are
  // blacklisted (blacklist.json next to this file), so they are dropped from every group
  // they belong to: a member that does not exist is a broken reference, and the data
  // check would refuse the mod. Only "products" is written here — the names of the
  // groups keep their vanilla values.
  "product_groups": [
    {
      "id": "rope_fibers",
      "products": [ "hemp", "jute", "ramie", "sisal", "kenaf", "yucca", "velvetleaf" ]
    },
    {
      "id": "writing_materials",
      "products": [ "clay_tablets", "wax_tablets", "parchment", "silk", "paper" ]
    },
    {
      "id": "tare",
      "products": [ "amphora", "wooden_barrel" ]
    }
  ]
}
