  // The mod is deliberately small: it is a template for a mod author and a fixture for
  // tests/test_mods.gd.
  "id": "test_mod",
  "name": "Test Mod",
  "authors": [ "The City team" ],
  "description": "A reference mod: adds glazed tiles and their workshop, and changes the price of flour and the cost of a hand mill.",
