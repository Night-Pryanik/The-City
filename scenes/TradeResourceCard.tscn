[gd_scene format=3]

[ext_resource type="Script" uid="uid://bgvaowdel0reo" path="res://scripts/underlined_label.gd" id="1_underline"]

; The template of a resource card for the left column of the "Trade" tab
; (the internal trade). The layout lives entirely here, and trade_tab.gd only
; instantiates the card and substitutes the values — therefore any element can be
; moved with the mouse in the scene editor.
;
; The nodes the script refers to (the names must not change):
;   Icon / NameLabel / PriorityButton — the header;
;   StockValue / QualityLabel         — the storage and the breakdown by quality;
;   PriceValue / ConsumersValue / ConsumptionValue — the numbers;
;   IncomeValue                       — the income to the treasury;
;   TradeCheckBox                     — the toggle of the consumption permission.
;
; IMPORTANT: PriceValue / ConsumersValue / ConsumptionValue / IncomeValue have
; mouse_filter = 0 (STOP). A Label has mouse_filter = IGNORE by default, and then
; the node does not catch the mouse at all: the signal mouse_entered NEVER comes,
; and the standard tooltip with it — without the flag the tooltip never shows
; (checked on Godot 4.7).
;
; PriceValue and IncomeValue are RichTextLabels, not Labels: both show a sum of
; coins, and the coin icon is a BBCode [img] tag (see ui_helpers.money).
;
; NameLabel carries the underlined_label.gd script and mouse_filter = 1 (PASS):
; the name of a group is a reference, so it is underlined with a dashed line and
; unfolds the composition of the group on hover. A single resource has an empty
; underline_text, therefore no underline is drawn.
; size_flags_vertical = 4 (SHRINK_CENTER) keeps the label at the height of its
; text: the underline is drawn along the lower bound of the label, and a label
; stretched to the 32-px header would draw it far below the name.

[node name="TradeCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 0)
offset_right = 520.0
offset_bottom = 104.0

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Icon" type="TextureRect" parent="Layout/Header"]
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5

[node name="NameLabel" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 1
text = "Resource"
script = ExtResource("1_underline")

[node name="PriorityButton" type="Button" parent="Layout/Header"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Consumption priority"
text = "★"

[node name="TradeCheckBox" type="CheckBox" parent="Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Allow consumption on the domestic market"
button_pressed = true

[node name="StockRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="StockCaption" type="Label" parent="Layout/StockRow"]
layout_mode = 2
size_flags_vertical = 1
text = "Storage:"

[node name="StockValue" type="Label" parent="Layout/StockRow"]
layout_mode = 2
text = "0"

[node name="QualityLabel" type="RichTextLabel" parent="Layout/StockRow"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_vertical = 4
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="DetailRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="PriceCaption" type="Label" parent="Layout/DetailRow"]
layout_mode = 2
size_flags_vertical = 1
text = "Price:"

[node name="PriceValue" type="RichTextLabel" parent="Layout/DetailRow"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 0
bbcode_enabled = true
text = "0"
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="ConsumersCaption" type="Label" parent="Layout/DetailRow"]
layout_mode = 2
size_flags_vertical = 1
text = "Buyers:"

[node name="ConsumersValue" type="Label" parent="Layout/DetailRow"]
layout_mode = 2
mouse_filter = 0
text = "0"

[node name="ConsumptionCaption" type="Label" parent="Layout/DetailRow"]
layout_mode = 2
size_flags_vertical = 1
text = "Consumption per 1:"

[node name="ConsumptionValue" type="Label" parent="Layout/DetailRow"]
layout_mode = 2
mouse_filter = 0
text = "0/sec"

[node name="IncomeRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="IncomeCaption" type="Label" parent="Layout/IncomeRow"]
layout_mode = 2
size_flags_vertical = 1
text = "Income:"

[node name="IncomeValue" type="RichTextLabel" parent="Layout/IncomeRow"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 0
bbcode_enabled = true
text = "0/sec"
fit_content = true
scroll_active = false
autowrap_mode = 0
