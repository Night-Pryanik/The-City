[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/journal_ui.gd" id="1_jrnl"]
[ext_resource type="Script" path="res://scripts/scrim.gd" id="2_scrim"]

[node name="Journal" type="Control"]
layout_mode = 1
script = ExtResource("1_jrnl")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_scrim")

[node name="WindowPanel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -330.0
offset_top = -260.0
offset_right = 330.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"SurfaceWindow"

[node name="Margin" type="MarginContainer" parent="WindowPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="WindowPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="WindowPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="WindowPanel/Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
text = "Journal"
theme_override_font_sizes/font_size = 24

[node name="MarkAllButton" type="Button" parent="WindowPanel/Margin/VBox/Header"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Mark all messages as read"
expand_icon = true

[node name="ClearAllButton" type="Button" parent="WindowPanel/Margin/VBox/Header"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Delete all messages"
expand_icon = true

[node name="CloseButton" type="Button" parent="WindowPanel/Margin/VBox/Header"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Close the journal (ESC)"
expand_icon = true

[node name="EmptyLabel" type="Label" parent="WindowPanel/Margin/VBox"]
visible = false
layout_mode = 2
text = "No messages yet."
autowrap_mode = 3
theme_type_variation = &"MutedLabel"

[node name="Scroll" type="ScrollContainer" parent="WindowPanel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="WindowPanel/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
