msgstr "Создаёт глиняные таблички для записей"

msgctxt "crafts.description"
msgid "Cuts stone into plates, bowls, and cups."
msgstr "Вырезает из камня тарелки, миски и чашки."

msgctxt "crafts.description"
msgid "Dries and roasts coffee beans."
msgstr "Сушит и обжаривает кофейные зерна"

msgctxt "crafts.description"
