msgctxt "professions.description"
msgid "A pseudo-profession that covers the whole population of the city, including employed citizens."
msgstr "Псевдо-профессия: охватывает всё население города, включая занятых жителей."

msgctxt "professions.description"
msgid "Burns wood into charcoal."
msgstr "Обжигает древесину в древесный уголь."

msgctxt "professions.description"
msgid "Copies and studies texts in the library and scriptorium, adding to the city's science."
msgstr "Переписывает и исследует тексты в библиотеке и скриптории, пополняя пул науки."

msgctxt "professions.description"
msgid "Cultivates the vineyard and gathers the harvest."
msgstr "Возделывает виноградник, собирает урожай."

msgctxt "professions.description"
msgid "Digs and sorts clay for firing."
msgstr "Копает и сортирует глину для обжига."

msgctxt "professions.description"
msgid "Digs ore and minerals out of the ground."
msgstr "Добывает руду и минералы под землёй."

msgctxt "professions.description"
msgid "Extracts soda from natural deposits."
msgstr "Добывает соду из природных отложений."

msgctxt "professions.description"
msgid "Extracts stone from open quarries."
msgstr "Добывает камень в открытых карьерах."

msgctxt "professions.description"
msgid "Fells trees in forest plots and hauls in the timber."
msgstr "Рубит деревья на лесной делянке и заготавливает древесину."

msgctxt "professions.description"
msgid "Fishes from boats on any water body with a dock."
msgstr "Ловит рыбу с лодок на водоёмах с пристанью."

msgctxt "professions.description"
msgid "Forges tools, weapons and ornaments from metal."
msgstr "Кует инструменты, оружие и украшения из металла."

msgctxt "professions.description"
msgid "Gathers and boils down natural tar."
msgstr "Собирает и выпаривает природную смолу."

msgctxt "professions.description"
msgid "Grows technical and spice crops."
msgstr "Возделывает технические и пряные культуры."

msgctxt "professions.description"
msgid "Smelts ore into pure metals."
msgstr "Плавит руду в чистые металлы."

msgctxt "professions.description"
msgid "Tends the herd and keeps count of the livestock."
msgstr "Присматривает за стадом, следит за поголовьем."

msgctxt "professions.description"
msgid "Tends the hives and harvests honey."
msgstr "Следит за ульями, собирает мёд."

msgctxt "professions.description"
msgid "Turns sand and soda into glass."
msgstr "Превращает песок и соду в стекло."

msgctxt "professions.description"
msgid "Works the fields and tends the crops."
msgstr "Возделывает поля, ухаживает за посевами."

