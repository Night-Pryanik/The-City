msgstr "Варит пульке из агавы"

msgctxt "crafts.description"
msgid "Brews sake from rice."
msgstr "Варит саке из риса"

msgctxt "crafts.description"
msgid "Builds a boat from reeds."
msgstr "Создает лодку из тростника"

msgctxt "crafts.description"
msgid "Burns limestone into lime."
msgstr "Обжигает известняк в известь"

msgctxt "crafts.description"
msgid "Burns wood into charcoal."
msgstr "Обжигает древесину в древесный уголь."

msgctxt "crafts.description"
