msgctxt "roads.description"
msgid "A leveled road for carts. Three times the load of a trail."
msgstr "Ровная дорога для телег. Позволяет перевозить втрое больше, чем тропка."

msgctxt "roads.description"
msgid "A simple footpath worn into the ground. Cheap, but it carries very little."
msgstr "Простая тропа, протоптанная в земле. Дёшево, но мало что везёт."

msgctxt "roads.name"
msgid "Cart Road"
msgstr "Тележная дорога"

msgctxt "roads.name"
msgid "Trail"
msgstr "Тропка"

