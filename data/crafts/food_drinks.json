    {
      // The slaughterhouse butchers the live herd into the meat of the
      // species and, where the animal bears a usable hide, into hides.
      // The meats are distinct products on purpose: a diversity of meats on
      // the table is the basis of the diversity bonus system (see
      // data/bonuses.json). All the bovines share the "Beef" recipe through
      // the @bovines group (data/product_groups/crafts.json).
      //
      // Every slaughter recipe has the same throughput: 20 heads into 120 units
      // of meat (24 per second) in 5 seconds, whatever the species, plus the
      // hide of the animals that bear one. The craft takes time like every other
      // recipe, and one slaughterhouse fed at 4 heads per second (the pasture
      // batch in animals.json) runs without idle time. The slaughterhouse works
      // at its own rate and does not wait for the pasture: the batch is sized to
      // supply it, but the two buildings are independent of each other.
      "id": "beef",
      "name": "Beef",
      "produced_in": [ "slaughterhouse" ],
      "resources": { "@bovines": 20 },
      "result": { "beef": 120, "hide": 20 },
      "time": 5
    },
