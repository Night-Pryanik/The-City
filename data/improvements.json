      "unlock_tech": "soda_extraction",
      "profession": "soda_extractor"
    },
    {
      // Пристань — «ключ» к водным ресурсам конкретного водоёма. Строится на
      // ПУСТОМ прибрежном гексе (суша рядом с lake/sea) через панель управления.
      // После постройки все ресурсы этого водоёма (находятся flood-fill по воде,
      // см. MapHelpers.has_harbor_access) становятся доступны для эксплуатации:
      // на них можно строить улучшения с флагом requires_harbor (сейчас —
      // fishing_boats). Для каждого водоёма нужна СВОЯ пристань. Доступ
      // вычисляется динамически (BFS по воде), поэтому при сносе пристани
      // ресурсы водоёма снова становятся недоступными для НОВЫХ построек.
      // ПРОФЕССИИ И РАБОЧИЕ: обычные улучшения имеют поле "profession" — id
      // профессии рабочего (см. data/professions.json). Дополнительно поле
      // "no_worker": true помечает улучшение как ИНФРАСТРУКТУРНОЕ: оно не
      // требует рабочего для выполнения своих функций (рабочих нельзя
      // назначать, кнопок «Запустить/Приостановить работу» в панели нет).
      "id": "harbor",
      "name": "Пристань",
      "icon": "harbor.png",
      "color": [ 139, 90, 43 ],
      "work_cost": 25,
      "unlock_tech": "fishing",
      // Инфраструктура: открывает водные ресурсы водоёма сама по себе,
      // рабочий не требуется (см. docs.md, «Профессии и потребление ресурсов»).
      "no_worker": true,
      // Маркер: это улучшение открывает водные ресурсы своего водоёма.
      "water_body_harbor": true
    },
    {
      // Рыбацкие лодки — добывают рыбу. Строить можно ТОЛЬКО на гексах с рыбным
      // ресурсом, принадлежащих водоёму, на котором есть пристань (см. флаги
      // water_body_harbor у пристани и has_harbor_access в map_helpers.gd).
      "id": "fishing_boats",
      "name": "Рыбацкие лодки",
      "icon": "fishing_boats.png",
      "color": [ 70, 130, 180 ],
      "work_cost": 15,
      "unlock_tech": "fishing",
      "profession": "fisherman",
      // Маркер: для постройки требуется пристань на этом же водоёме.
      "requires_harbor": true
    },
    {
      // Ирригационный канал: инфраструктурное улучшение-проводник, открытое
      // технологией «Каналы». Раздаёт пресную воду соседям (conducts_water)
      // и сам является каналом (is_canal), чтобы is_hex_adjacent_to_canal
      // (MapHelpers) считал соседние гексы прямыми источниками пресной воды.
      "id": "irrigation_canal",
      "name": "Ирригационный канал",
      "icon": "irrigation_canal.png",
      "color": [ 0, 191, 255 ],
      "work_cost": 20,
      "unlock_tech": "canals",
      "conducts_water": true,
      "is_canal": true,
      "no_worker": true
    }
  ]
}