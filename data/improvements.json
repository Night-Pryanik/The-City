    {
      // The harbor — the "key" to the water resources of a specific body of water.
      // It is built on an EMPTY coastal hex (land next to lake/sea) via the
      // control panel. After the build, all resources of that body of water
      // (found by flood-fill over the water, see MapHelpers.has_harbor_access)
      // become available for exploitation: improvements with the requires_harbor
      // flag can be built on them (currently — fishing_boats). Each body of
      // water needs its OWN harbor. Access is computed dynamically (BFS over
      // water), so when the harbor is demolished the resources of that body of
      // water become unavailable for NEW builds once again.
      // PROFESSIONS AND WORKERS: ordinary improvements have the "profession"
      // field — the id of the worker's profession (see data/professions.json).
      // In addition, the "no_worker": true field marks an improvement as
      // INFRASTRUCTURE: it does not require a worker to perform its functions
      // (workers cannot be assigned, and there are no "Start/Pause work" buttons
      // in the panel).
      "id": "harbor",
      "name": "Harbor",
      "icon": "harbor.png",
      "color": [ 139, 90, 43 ],
      "work_cost": 25,
      "unlock_tech": "fishing",
      // Infrastructure: it opens the water resources of the body of water by
      // itself, no worker is required (see docs.md, "Professions and
      // resource consumption").
      "no_worker": true,
      // Marker: this improvement opens the water resources of its body of water.
      "water_body_harbor": true,
      // Infrastructure without production: the field is formal
      // (a single data scheme).
      "production_interval": 2
    },
    {
      // Fishing boats — catch fish. They can be built ONLY on hexes with a fish
      // resource belonging to a body of water that has a harbor (see the
      // water_body_harbor flag on the harbor and has_harbor_access in
      // map_helpers.gd).
      "id": "fishing_boats",
      "name": "Fishing Boats",
      "icon": "fishing_boats.png",
      "color": [ 70, 130, 180 ],
      "work_cost": 15,
      "unlock_tech": "fishing",
      "profession": "fisherman",
      // Fish is food: just like the farm, it outputs its catch every second
      // (food is written off every simulation tick).
      "production_interval": 1,
      // Marker: a harbor on this same body of water is required for the build.
      "requires_harbor": true,
      "no_road": true
    },
    {
      // Irrigation canal: an infrastructure conductor improvement unlocked by
      // the technology "Canals". It distributes fresh water to neighbours
      // (conducts_water) in the "by chain" mode (is_canal): the chain of water
      // goes through canals just as through farms/plantations, with the range
      // limit from tech_modifiers.
      "id": "irrigation_canal",
      "name": "Irrigation Canal",
      "icon": "irrigation_canal.png",
      "color": [ 0, 191, 255 ],
      "work_cost": 20,
      "unlock_tech": "canals",
      "conducts_water": true,
      "is_canal": true,
      "no_worker": true,
      // A road to a canal is NOT laid: this is an infrastructure element,
      // and extending a road network to it makes no sense.
      "no_road": true,
      // Infrastructure without production: the field is formal
      // (a single data scheme).
      "production_interval": 2
    },
    {
      // The woodcutter's camp — a logging improvement. It works in TWO modes
      // (both branches are supported, no code change is needed for future
      // resources):
      //   1) ON A WOOD RESOURCE: if the hex has a raw resource with
      //      improved_by == "lumberjack_hut" (future cedar, oak, tulipwood,
      //      Paulownia and so on), the camp extracts it as an ORDINARY
      //      improvement via the common flow (tile.resource + produces) and
      //      outputs the specific product of that resource (redwood, ship timber,
      //      dyes, etc.). For that it is enough to set
      //      improved_by == "lumberjack_hut" in data/resources/*.json.
      //   2) ON AN EMPTY FOREST HEX: if there is no resource but the cover
      //      gives timber (wood_yield > 0 in data/covers.json), the camp outputs
      //      ordinary "Wood" derived from the density of the cover: sparse forest
      //      — 1, continuous forest — 2. Any future forest cover with
      //      wood_yield > 0 will fit without a code change.
      //      It is built on an empty DRY hex (not a swamp, not marsh, not water).
      // Implementation: calculation/crediting is in main_map.gd (the production
      // tick), availability/preview is in control_panel.gd and map_tooltip.gd.
      "id": "lumberjack_hut",
      "name": "Woodcutter's Camp",
      "icon": "lumberjack_hut.png",
      "color": [ 101, 67, 33 ],
      "work_cost": 18,
      "unlock_tech": "wood_processing",
      "profession": "lumberjack",
      "production_interval": 2
    }
  ]
}