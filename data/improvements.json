{
  // IMPORTANT: the farm / pasture / beehive / vineyard / plantation
  // improvements work in TWO modes (see docs.md, the section
  // "Breeding animals and plants (crop_bred scheme)"):
  //   1) The hex ALREADY has a natural resource (the improved_by field points
  //      to this improvement in data/resources/*.json). The build keeps
  //      tile.resource, and the quality is the current one.
  //   2) The hex is empty — the player breeds a domesticated species. The id
  //      of the animal/plant is written to tile.crop_bred, tile.resource stays
  //      null. The quality is inherited from an already domesticated specimen
  //      of that species.
  // PRODUCTION: the "production_interval" field — the time in SECONDS it takes
  // for the improvement to output its product (in one "batch", as long as there
  // is a worker on it). The countdown runs on the game simulation tick
  // SIMULATION_TICK = 1 sec (CityData.SIMULATION_TICK, the step in main_map.gd).
  // Feed (feed_consumption) is written off per production cycle, not every tick.
  // Infrastructure improvements (no_worker / without production) carry the field
  // formally.
  "improvements": [
    {
      "id": "farm",
      "name": "Farm",
      "icon": "farm.png",
      "color": [ 255, 255, 0 ],
      "work_cost": 8,
      "unlock_tech": "farming",
      // The profession of the worker on this improvement. The label is set/cleared
      // automatically in worker_manager.gd on assignment/dismissal.
      "profession": "farmer",
      // The main source of food: food is written off every simulation tick
      // (1 sec), so the farm outputs its crop every second.
      "production_interval": 1,
      // A conductor of fresh water: after the technology "Irrigation" is
      // researched, the farm spreads fresh water to neighbouring hexes
      // (the water_access scheme: chain).
      "conducts_water": true
    },
    {
      "id": "pasture",
      "name": "Pasture",
      "icon": "pasture.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 25,
      "unlock_tech": "animal_husbandry",
      "profession": "herder",
      // Feed (the feed_consumption of a resource) is written off per production cycle.
      "production_interval": 2
    },
