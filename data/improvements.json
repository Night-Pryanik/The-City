{
  // ВАЖНО: улучшения farm / pasture / beehive / vineyard / plantation /
  // работают в ДВУХ режимах (см. docs.md, раздел
  // «Разведение животных и растений (схема crop_bred)»):
  //   1) На гексе УЖЕ есть природный ресурс (поле improved_by указывает
  //      на это улучшение в data/resources/*.json). Постройка сохраняет
  //      tile.resource, качество берётся текущее.
  //   2) Гекс пустой — игрок разводит одомашненный вид. Id животного/
  //      растения пишется в tile.crop_bred, tile.resource остаётся null.
  //      Качество наследуется от уже одомашненного экземпляра этого вида.
  // ПРОИЗВОДСТВО: поле "production_interval" — время в СЕКУНДАХ, за которое
  // улучшение выдаёт свою продукцию (одной «пачкой», пока на нём есть рабочий).
  // Отсчёт идёт по тику игровой симуляции SIMULATION_TICK = 1 сек
  // (CityData.SIMULATION_TICK, шаг в main_map.gd). Корм (feed_consumption)
  // списывается за цикл производства, а не каждый тик. Инфраструктурные
  // улучшения (no_worker / без производства) носят поле формально.
  "improvements": [
    {
      "id": "farm",
      "name": "Ферма",
      "icon": "farm.png",
      "color": [ 255, 255, 0 ],
      "work_cost": 8,
      "unlock_tech": "farming",
      // Профессия рабочего на этом улучшении. Метка ставится/снимается
      // автоматически в worker_manager.gd при назначении/увольнении.
      "profession": "farmer",
      // Главный источник еды: еда списывается каждый тик симуляции (1 сек),
      // поэтому ферма выдаёт урожай каждую секунду.
      "production_interval": 1,
      // Проводник пресной воды: после изучения технологии «Орошение» ферма
      // распространяет пресную воду на соседние гексы (схема water_access: chain).
      "conducts_water": true
    },
    {
      "id": "pasture",
      "name": "Пастбище",
      "icon": "pasture.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 25,
      "unlock_tech": "animal_husbandry",
      "profession": "herder",
      // Корм (feed_consumption ресурса) списывается за цикл производства.
      "production_interval": 2
    },
    {
      "id": "mine",
      "name": "Шахта",
      "icon": "mine.png",
      "color": [ 105, 105, 105 ],
