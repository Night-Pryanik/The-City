{
  // ВАЖНО: улучшения farm / pasture / beehive / vineyard / plantation /
  // clay_pit работают в ДВУХ режимах (см. docs.md, раздел
  // «Разведение животных и растений (схема crop_bred)»):
  //   1) На гексе УЖЕ есть природный ресурс (поле improved_by указывает
  //      на это улучшение в data/resources/*.json). Постройка сохраняет
  //      tile.resource, качество берётся текущее.
  //   2) Гекс пустой — игрок разводит одомашненный вид. Id животного/
  //      растения пишется в tile.crop_bred, tile.resource остаётся null.
  //      Качество наследуется от уже одомашненного экземпляра этого вида.
  "improvements": [
    {
      // Ферма: добывает зерновые/клубневые с гекса (improved_by == "farm"
      // у ресурса). Также используется для РАЗВЕДЕНИЯ одомашненных
      // растений на пустом гексе (tile.crop_bred).
      "id": "farm",
      "name": "Ферма",
      "icon": "farm.png",
      "color": [ 255, 255, 0 ],
      "work_cost": 8,
      "unlock_tech": "farming"
    },
    {
      // Пастбище: добывает животных с гекса (improved_by == "pasture"
      // у ресурса). Также используется для РАЗВЕДЕНИЯ одомашненных
      // животных на пустом гексе (tile.crop_bred).
      "id": "pasture",
      "name": "Пастбище",
      "icon": "pasture.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 25,
      "unlock_tech": "animal_husbandry"
    },
    {
      "id": "mine",
      "name": "Шахта",
      "icon": "mine.png",
      "color": [ 105, 105, 105 ],
      "work_cost": 30,
      "unlock_tech": "mining"
    },
    {
      "id": "quarry",
      "name": "Каменоломня",
      "icon": "quarry.png",
      "color": [ 139, 137, 137 ],
      "work_cost": 20,
      "unlock_tech": "masonry"
    },
    {
      // Пасека: работает с природным ресурсом "bee" (improved_by == "beehive").
      // Разведение пчёл на пустом гексе тоже идёт через crop_bred.
      "id": "beehive",
      "name": "Пасека",
      "icon": "beehive.png",
      "color": [ 255, 215, 0 ],
      "work_cost": 12,
      "unlock_tech": "beekeeping"
    },
    {
      // Виноградник: добывает виноград (improved_by == "vineyard" у растения)
      // и используется для разведения сортов на пустом гексе.
      "id": "vineyard",
      "name": "Виноградник",
      "icon": "vineyard.png",
      "color": [ 128, 0, 0 ],
      "work_cost": 35,
      "unlock_tech": "winegrowing"
    },
    {
      "id": "clay_pit",
      "name": "Глиняная яма",
      "icon": "clay_pit.png",
      "color": [ 210, 180, 140 ],
      "work_cost": 22,
      "unlock_tech": "pottery"
    },
    {
      // Плантация: улучшение для разведения технических/пряных культур на
      // пустых гексах (tile.crop_bred), а также для сбора дикорастущих
      // плантационных культур (improved_by == "plantation").
      "id": "plantation",
      "name": "Плантация",
      "icon": "plantation.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 28,
      "unlock_tech": "plantations"
    },
    {
      "id": "tar_pit",
      "name": "Смоляная яма",
      "icon": "tar_pit.png",
      "color": [ 139, 69, 19 ],
      "work_cost": 30,
      "unlock_tech": "bitumen_extraction"
    },
    {
      // Содовый карьер — улучшение для добычи соды на гексах содового озера.
      // Открывается технологией "Добыча соды" (soda_extraction).
      // Иконки нет — рендерер использует цвет-заглушку.
      "id": "soda_quarry",
      "name": "Содовый карьер",
      "icon": "soda_quarry.png",
      "color": [ 200, 220, 255 ],
      "work_cost": 30,
      "unlock_tech": "soda_extraction"
    }
  ]
}