      "work_cost": 35,
      "unlock_tech": "winegrowing",
      "profession": "vinedresser",
      "production_interval": 2
    },
    {
      "id": "clay_pit",
      "name": "Глиняная яма",
      "icon": "clay_pit.png",
      "color": [ 210, 180, 140 ],
      "work_cost": 22,
      "unlock_tech": "pottery",
      "profession": "potter",
      "production_interval": 2
    },
    {
      "id": "plantation",
      "name": "Плантация",
      "icon": "plantation.png",
      "color": [ 34, 139, 34 ],
      "work_cost": 28,
      "unlock_tech": "plantations",
      "profession": "planter",
      "production_interval": 2,
      // Проводник пресной воды: после изучения технологии «Орошение» плантация
      // распространяет пресную воду на соседние гексы (схема water_access: chain).
      "conducts_water": true
    },
    {
      "id": "tar_pit",
      "name": "Смоляная яма",
      "icon": "tar_pit.png",
      "color": [ 139, 69, 19 ],
      "work_cost": 30,
      "unlock_tech": "bitumen_extraction",
      "profession": "tar_collector",
      "production_interval": 3
    },
    {
      "id": "soda_quarry",
      "name": "Содовый карьер",
      "icon": "soda_quarry.png",
      "color": [ 200, 220, 255 ],
      "work_cost": 30,
      "unlock_tech": "soda_extraction",
      "profession": "soda_extractor",
      "production_interval": 3
    },
    {
      "id": "salt_pond",
      "name": "Соляный пруд",
      "icon": "salt_pond.png",
      "color": [ 255, 255, 200 ],
      "work_cost": 30,
      "unlock_tech": "salt_extraction",
      "production_interval": 2
    },
    {
      // Пристань — «ключ» к водным ресурсам конкретного водоёма. Строится на
      // ПУСТОМ прибрежном гексе (суша рядом с lake/sea) через панель управления.
      // После постройки все ресурсы этого водоёма (находятся flood-fill по воде,
      // см. MapHelpers.has_harbor_access) становятся доступны для эксплуатации:
      // на них можно строить улучшения с флагом requires_harbor (сейчас —
      // fishing_boats). Для каждого водоёма нужна СВОЯ пристань. Доступ
      // вычисляется динамически (BFS по воде), поэтому при сносе пристани
      // ресурсы водоёма снова становятся недоступными для НОВЫХ построек.
      // ПРОФЕССИИ И РАБОЧИЕ: обычные улучшения имеют поле "profession" — id
      // профессии рабочего (см. data/professions.json). Дополнительно поле
      // "no_worker": true помечает улучшение как ИНФРАСТРУКТУРНОЕ: оно не
      // требует рабочего для выполнения своих функций (рабочих нельзя
      // назначать, кнопок «Запустить/Приостановить работу» в панели нет).
      "id": "harbor",
      "name": "Пристань",
      "icon": "harbor.png",
      "color": [ 139, 90, 43 ],
      "work_cost": 25,
      "unlock_tech": "fishing",
      // Инфраструктура: открывает водные ресурсы водоёма сама по себе,
      // рабочий не требуется (см. docs.md, «Профессии и потребление ресурсов»).
      "no_worker": true,
      // Маркер: это улучшение открывает водные ресурсы своего водоёма.
      "water_body_harbor": true,
      // Инфраструктура без производства: поле формальное (единая схема данных).
      "production_interval": 2
    },
    {
      // Рыбацкие лодки — добывают рыбу. Строить можно ТОЛЬКО на гексах с рыбным
      // ресурсом, принадлежащих водоёму, на котором есть пристань (см. флаги
      // water_body_harbor у пристани и has_harbor_access в map_helpers.gd).
      "id": "fishing_boats",
      "name": "Рыбацкие лодки",
      "icon": "fishing_boats.png",
      "color": [ 70, 130, 180 ],
      "work_cost": 15,
      "unlock_tech": "fishing",
      "profession": "fisherman",
      // Рыба — еда: как и ферма, выдаёт улов каждую секунду (еда списывается
      // каждый тик симуляции).
      "production_interval": 1,
      // Маркер: для постройки требуется пристань на этом же водоёме.
      "requires_harbor": true,
      "no_road": true
    },
    {
      // Ирригационный канал: инфраструктурное улучшение-проводник, открытое
      // технологией «Каналы». Раздаёт пресную воду соседям (conducts_water)
      // в режиме «по цепочке» (is_canal): цепочка воды идёт через каналы,
      // как и через фермы/плантации, с ограничением дальности из tech_modifiers.
      "id": "irrigation_canal",
      "name": "Ирригационный канал",
      "icon": "irrigation_canal.png",
      "color": [ 0, 191, 255 ],
      "work_cost": 20,
      "unlock_tech": "canals",
      "conducts_water": true,
      "is_canal": true,
      "no_worker": true,
      // Дорога к каналу НЕ прокладывается: это инфраструктурный элемент,
      // и тянуть к нему сеть дорог не имеет смысла.
      "no_road": true,
      // Инфраструктура без производства: поле формальное (единая схема данных).
      "production_interval": 2
    },
    {
      // Лесная делянка — улучшение лесозаготовки. Работает в ДВУХ режимах
      // (обе ветки поддерживаются, код править при будущих ресурсах не нужно):
      //   1) НА ДРЕВЕСНОМ РЕСУРСЕ: если на гексе есть сырьевой ресурс с
      //      improved_by == "lumberjack_hut" (будущие кедр, дуб, фернамбук,
      //      кампешевое дерево и т.п.), делянка добывает его как ОБЫЧНОЕ
      //      улучшение через общий поток (tile.resource + produces) и выдаёт
      //      специфический продукт этого ресурса (красное дерево, корабельный
      //      лес, красители и т.д.). Для этого достаточно в data/resources/*.json
      //      указать improved_by == "lumberjack_hut".
      //   2) НА ПУСТОМ ЛЕСНОМ ГЕКСЕ: если ресурса нет, а покров даёт древесину
      //      (wood_yield > 0 в data/covers.json), делянка выдаёт обычную
      //      «Древесину» из густоты покрова: редколесье — 1, сплошной лес — 2.
      //      Любой будущий лесной покров с wood_yield > 0 подойдёт без правки кода.
      //      Строится на пустом СУХОМ гексе (не болото, не марши, не вода).
      // Реализация: расчёт/зачисление — в main_map.gd (тик производства),
      // доступность/превью — в control_panel.gd и map_tooltip.gd.
      "id": "lumberjack_hut",
      "name": "Лесная делянка",
      "icon": "lumberjack_hut.png",
      "color": [ 101, 67, 33 ],
      "work_cost": 18,
      "unlock_tech": "wood_processing",
      "profession": "lumberjack",
      "production_interval": 2
    }
  ]
}