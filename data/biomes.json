{
  // The biomes of the world map: a pair (temperature, humidity) selects a biome, and the biome
  // decides what vegetation grows on the plains and hills of its region (see map_generator.gd).
  //
  // temperature: "cold" | "mild" | "hot" — a belt of the climate. The belts always go
  //   from the poles to the equator in the order cold → mild → hot → mild → cold, so two
  //   hexes of the same latitude never belong to non-neighbouring belts (see the "climate"
  //   block of data/map_config.json).
  // humidity:    "wet" | "dry" — a large region of the moisture field. The moisture does not
  //   follow the latitudes: wet and dry regions lie anywhere and surround each other.
  //
  // Every pair of the two axes has exactly one biome. A pair with no biome is a data problem:
  // the generator falls back to any biome of the same temperature.
  "biomes": [
    {
      "id": "taiga",
      "name": "Taiga",
      "temperature": "cold",
      "humidity": "wet",
      // The wash laid over the terrain icons of the biome (a colour and its opacity).
      // It carries the visible difference between the biomes whose vegetation is the same:
      // a cool blue-grey cast for the taiga, a grey one for the tundra, a yellow one for the steppe.
      "tint": [ 150, 185, 205 ],
      "tint_alpha": 0.30,
      // The vegetation pool of the plains and hills of the biome, in the same format
      // as cover_chance in data/terrains.json.
      "cover_chance": { "none": 30, "taiga": 45, "taiga_sparse": 25 }
    },
    {
      "id": "tundra",
      "name": "Tundra",
      "temperature": "cold",
      "humidity": "dry",
      "tint": [ 200, 212, 220 ],
      "tint_alpha": 0.55,
      "cover_chance": { "none": 88, "taiga_sparse": 12 }
    },
    {
      "id": "temperate_forest",
      "name": "Temperate Forest",
      "temperature": "mild",
      "humidity": "wet",
      // The temperate forest is the only biome whose look is set by its vegetation alone.
      "tint": [ 255, 255, 255 ],
      "tint_alpha": 0.0,
      "cover_chance": { "none": 40, "sparse_forest": 25, "forest": 35 }
    },
    {
      "id": "steppe",
      "name": "Steppe",
      "temperature": "mild",
      "humidity": "dry",
      "tint": [ 225, 205, 110 ],
      "tint_alpha": 0.45,
      "cover_chance": { "none": 88, "sparse_forest": 12 }
    },
    {
      "id": "jungle",
      "name": "Jungle",
      "temperature": "hot",
      "humidity": "wet",
      "tint": [ 50, 130, 60 ],
      "tint_alpha": 0.28,
      "cover_chance": { "none": 22, "jungle": 50, "jungle_sparse": 28 }
    },
    {
      "id": "savanna",
      "name": "Savanna",
      "temperature": "hot",
      "humidity": "dry",
      "tint": [ 235, 190, 80 ],
      "tint_alpha": 0.50,
      "cover_chance": { "none": 78, "sparse_forest": 22 }
    }
  ]
}
