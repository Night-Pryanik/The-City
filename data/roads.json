{
  // УРОВНИ ДОРОГ — data/roads.json.
  //
  // Дорога состоит из УЧАСТКОВ (сегментов между соседними гексами, см.
  // scripts/road_manager.gd). Каждый участок принадлежит ровно одному уровню,
  // и уровень задаёт ДВА независимых числа:
  //
  //   work_cost  — базовая цена ОДНОГО участка этого уровня в труде, до
  //                множителей (местность, дальность от города, технологии).
  //                Итог по участку считает MapHelpers.get_road_step_work_cost
  //                по той же формуле, что и раньше, только база берётся отсюда,
  //                а не из work_cost спецдействия build_road.
  //
  //   max_speed  — «максимальная скорость»: сколько единиц ресурса в секунду
  //                эта дорога способна перевозить. Это НЕ скорость передвижения
  //                юнитов (юнитов в игре нет), а пропускная способность
  //                участка: ферма производит 15 ед/сек, но по тропке с
  //                max_speed = 10 в город повезут не больше 10 ед/сек.
  //
  // Поля записи:
  //   id          — строковый идентификатор (snake_case), как у всех сущностей;
  //   level       — порядковый номер уровня, 1-based. Уровни идут подряд, без
  //                 пропусков: level 1 — базовая тропка, дальше по одной
  //                 технологии на уровень;
  //   name        — название для игрока (переводится через data_loader,
  //                 см. DISPLAY_FIELDS);
  //   description — короткое пояснение, чем уровень лучше предыдущего;
  //   work_cost   — см. выше. Цена участка одинакова для всех дорог, в том числе
  //                 для той, что строится вместе с улучшением: она идёт
  //                 поэтапным проектом и оплачивается по участкам, поэтому
  //                 обнулять её ради постройки улучшения нельзя;
  //   max_speed   — см. выше, ед./сек на один участок;
  //   unlock_tech — id технологии, открывающей уровень. null/"" — уровень
  //                 доступен с начала игры. Проверяется data_validator.gd
  //                 (ссылка на несуществующую технологию — ошибка данных);
  //   color       — RGB 0..255, цвет участка на карте (map_renderer);
  //   width       — толщина линии участка на карте, в пикселях.
  //
  // Уровень участка хранится в СЕТИ ДОРОГ (road_manager.road_segments:
  // "row,col|row,col" -> level), а не в отдельном списке, иначе пришлось бы
  // держать две структуры о том же самом и синхронизировать их вручную.
  //
  // СЕЙЧАС в игре два уровня — этого достаточно, чтобы проверить сквозной
  // путь уровня (постройка → маршрут → средняя скорость → улучшение дороги).
  // Следующие уровни добавляются сюда записями + одной технологией на эпоху;
  // код менять для этого не нужно.
  "roads": [
    {
      "id": "trail",
      "level": 1,
      "name": "Trail",
      "description": "A simple footpath worn into the ground. Cheap, but it carries very little.",
      "work_cost": 5,
      "max_speed": 10,
      "unlock_tech": null,
      "color": [ 140, 110, 70 ],
      "width": 5
    },
    {
      "id": "cart_road",
      "level": 2,
      "name": "Cart Road",
      "description": "A leveled road for carts. Three times the load of a trail.",
      "work_cost": 10,
      "max_speed": 30,
      "unlock_tech": "wheel",
      "color": [ 120, 90, 55 ],
      "width": 8
    }
  ]
}