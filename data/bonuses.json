// Здесь указываются бонусы за наличие на складе города разнообразных ресурсов в составе групп и подгрупп. 
// Схема следующая: бонус типа bonus_type дается за владение как минимум min_subgroups в составе группы, а также за min_species число видов внутри подгруппы.
// Оба вида бонусов независимы друг от друга.
// Например: коровы, пчелы и домашняя птица - все относятся к группе livestock (домашние животные/скот).
// Если игрок владеет хотя бы двумя (min_subgroups: 2) видами домашних животных из этого списка (например, коровами и домашней птицей), то он получает бонус.
// Кроме того, если игрок владеет хотя бы двумя (min_species: 2) видами животных, относящимся к подгруппе,
// к примеру, meat_animals (коровы, зебу и бантенги), то он получает ещё один бонус.
//
// При создании новых групп стоит ориентироваться на те ресурсы, которые могут непосредственно употребляться в пищу,
// либо улучшать качество жизни людей, либо которые могут применяться при строительстве, либо на предметы роскоши.
// Например: хорошая идея давать бонус за наличие разнообразия мяса на столе жителей - например, говядина и курятина (оба - группа livestock).
// Также хорошая идея давать бонус за наличие разнообразия внутри подгруппы - например, мясо кур, уток и гусей (все три - подгруппа poultry).
// Хорошая идея давать бонус за наличие разнообразия строительного камня - например, мрамор и известняк (оба - подгруппа construction_materials).
// Но не очень хорошая идея давать бонус за наличие разнообразия минералов - например, строительный камень и драгоценный камень (подгруппы construction_materials и jewelry_minerals).
{
  "group_bonuses": [
    {
      "group_id": "livestock",
      "bonus_type": "happiness",
      "tiers": [ { "min_subgroups": 2, "value": 5 }, { "min_subgroups": 3, "value": 10 }, { "min_subgroups": 5, "value": 15 } ]
    },
    {
      "group_id": "food_plants",
      "bonus_type": "happiness",
      "tiers": [ { "min_subgroups": 2, "value": 3 }, { "min_subgroups": 3, "value": 7 }, { "min_subgroups": 5, "value": 12 } ]
    }
  ],
  "subgroup_bonuses": [
    {
      "subgroup_id": "meat_animals",
      "bonus_type": "happiness",
      "tiers": [ { "min_species": 2, "value": 2 }, { "min_species": 3, "value": 5 }, { "min_species": 5, "value": 10 } ]
    },
    {
      "subgroup_id": "poultry",
      "bonus_type": "happiness",
      "tiers": [ { "min_species": 2, "value": 1 }, { "min_species": 3, "value": 3 }, { "min_species": 5, "value": 6 } ]
    },
    {
      "subgroup_id": "fruits",
      "bonus_type": "happiness",
      "tiers": [ { "min_species": 2, "value": 1 }, { "min_species": 3, "value": 3 }, { "min_species": 5, "value": 5 } ]
    },
    {
      "subgroup_id": "construction_materials",
      "bonus_type": "happiness",
      "tiers": [ { "min_species": 2, "value": 1 }, { "min_species": 3, "value": 3 }, { "min_species": 5, "value": 5 } ]
    }
  ]
}
