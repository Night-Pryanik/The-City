    {
      "id": "oasis",
      "name": "Oasis",
      "color": [ 34, 139, 34 ],
      "alpha": 0.9,
      "move_cost_bonus": 0,
      // The cover is a direct source of fresh water: a hex with this cover
      // (and its neighbours) gives the water_access scheme the status "direct"
      // without any technology being researched. The equivalent flag
      // "fresh_water_source" is set on terrain in terrains.json (currently —
      // on "lake"). New fresh water sources only need to be given this field,
      // no code change is required.
      "fresh_water_source": true,
      "icons": [ "oasis_1.png", "oasis_2.png" ]
    }
  ]
}
