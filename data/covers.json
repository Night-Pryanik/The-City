{
  // The covers of the map: what grows ON TOP of the relief. A cover is a separate layer — a forest
  // is not a terrain, it lies over the plain, the hills or the mountains of the hex.
  //
  // The forests are split by the climate that grows them: the boreal forest (the taiga) of the cold
  // belt, the temperate one of the mild and the subtropical belts, and the tropical one near the
  // equator. Inside every belt the wet and the dry half grow different woods, and every wood has a
  // dense and a sparse variety — the sparse one is what a forest turns into at its edge.
  //
  // Which cover may grow where is decided by the "cover_chance" of the climate zone
  // (data/climate.json) — the pools are never listed here. The water, the wetlands and the deserts
  // keep their own pool in data/terrains/terrains.json.
  "covers": [
    { "id": "none", "name": "None", "color": [ 0, 0, 0 ], "alpha": 0.0, "move_cost_bonus": 0, "icons": [  ] },

    // --- THE POLAR BELT ------------------------------------------------------------------
    // The poles are too cold for a tree: the ground of the tundra is covered by moss and lichen,
    // which yields no timber. The cover has no icon yet — it is drawn as a translucent coloured
    // overlay, and the file names go here when the art appears.
    {
      "id": "tundra_moss",
      "name": "Moss and Lichen",
      "color": [ 186, 200, 196 ],
      "alpha": 0.45,
      "move_cost_bonus": 0,
      "icons": [  ]
    },

    // --- THE FORESTS OF THE MILD AND THE SUBTROPICAL BELTS -------------------------------
    {
      "id": "temperate_rainforest",
      "name": "Temperate Rainforest",
      "color": [ 34, 139, 34 ],
      "alpha": 0.9,
      "move_cost_bonus": 0,
      // Wood yield of this cover: how many units of wood a forest plot here
      // gives per tick, in the same units as the "produces" of a resource
      // (data/resources/**). The denser the forest, the higher the yield.
      // A forest plot can be built on any cover with wood_yield > 0 —
      // new forest covers only need this field, no code change is required.
      // A missing field = yield of 0.
      "wood_yield": 20,
      "icons": [ "forest_1.png", "forest_2.png", "forest_3.png" ]
    },
    {
      "id": "temperate_rainforest_sparse",
      "name": "Sparse Temperate Rainforest",
      "color": [ 34, 139, 34 ],
      "alpha": 0.55,
      "move_cost_bonus": 0,
      "wood_yield": 10,
      "icons": [ "forest_1.png", "forest_2.png", "forest_3.png" ]
    },
    {
      "id": "temperate_dry_forest",
      "name": "Temperate Dry Forest",
      "color": [ 96, 122, 44 ],
      "alpha": 0.8,
      "move_cost_bonus": 0,
      "wood_yield": 16,
      "icons": [ "forest_1.png", "forest_2.png", "forest_3.png" ]
    },
    {
      "id": "temperate_dry_forest_sparse",
      "name": "Sparse Temperate Dry Forest",
      "color": [ 96, 122, 44 ],
      "alpha": 0.5,
      "move_cost_bonus": 0,
      "wood_yield": 8,
      "icons": [ "forest_1.png", "forest_2.png", "forest_3.png" ]
    },

    // --- THE BOREAL FOREST ---------------------------------------------------------------
    // The taiga has no icon of its own yet: it is drawn as a translucent coloured overlay, and the
    // file names go here when the art appears.
    {
      "id": "taiga",
      "name": "Taiga",
      "color": [ 30, 90, 70 ],
      "alpha": 0.4,
      "move_cost_bonus": 0,
      "wood_yield": 20,
      "icons": [  ]
    },
    {
      "id": "taiga_sparse",
