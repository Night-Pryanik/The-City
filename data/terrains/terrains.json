  // The terrains of the map: the RELIEF of a hex (what lies under the vegetation).
  //
  // Every passable land relief has a "family" — plain, hill or mountain — and the climate turns it
  // into one of its VARIANTS: the same plain is a boreal plain in the cold belt, a steppe or a
  // prairie in the mild one, a savanna in the subtropical one and a tropical plain near the equator
  // (see data/climate.json). The variant is the terrain of the hex: it is what the game stores and
  // what the resources are placed on. There is no generic "plain" on the map — a plain is always one
  // of its varieties.
  //
  // The NAME of a variety is the climate zone and the relief together: "Boreal, Plain",
  // "Tropical, Hills". The mountains are the same in every zone, so their name carries no zone —
  // they are just "Mountains". The cover of a hex is appended to the name when the hex is shown to
  // the player: "Tropical, Hills, tropical forest" (GameData.terrain_display_name).
  //
  // The family is what the game means by "a plain" wherever the climate does not matter:
  // a resource that grows on allowed_terrain ["plain"] grows on all five of them, and the
  // vegetation of a hex is taken from the cover_chance of its climate zone (data/climate.json),
  // not from the terrain record.
  //
  // The variants of one family share the icons of the family: the climate is told by the "tint" —
  // a colour wash drawn over the icon by the map renderer (see map_renderer._draw_terrain_tint).
  // "color" is the flat colour of the hex, used where no icon is available.
  "terrains": [
    // --- THE COLD BELT: the boreal zone ---------------------------------------------------
    {
      "id": "boreal_plain",
      "name": "Boreal, Plain",
      "family": "plain",
      "color": [ 196, 208, 200 ],
      "tint": [ 200, 212, 220 ],
      "tint_alpha": 0.55,
      "move_cost": 1,
      "expansion_cost": 2,
      "icons": [ "plain_1.png", "plain_2.png", "plain_3.png" ]
    },
    {
      "id": "boreal_hill",
      "name": "Boreal, Hills",
      "family": "hill",
      "color": [ 150, 148, 140 ],
