    // --- THE WETLANDS: the swamp of every belt --------------------------------------------
    // A swamp is waterlogged ground, not a relief, so it is a family of its own: the Voronoi
    // spreads it under the name "swamp" (data/map_config.json → terrain_config) and the climate
    // turns every hex of it into the variety of its belt. A zone names its swamp in
    // data/climate.json → terrain.swamp.
    //
    // There is no record per zone: a wetland differs from its neighbour only where the climate
    // does — the frozen bog of the tundra, the stunted taiga bog, the wooded carr of the mild
    // belt and the reed bed of the warm one. The steppe and the prairie therefore share one
    // swamp, and the two warm belts share another.
    //
    // The vegetation of a swamp comes from its OWN cover_chance, never from the pool of the
    // climate zone: the ground is under water, and a jungle cannot grow on it just because the
    // jungle grows around it. That is what keeps the reed beds (and the papyrus that grows in
    // them) in the warm belts and the moss of the tundra out of the tropics.
    //
    // All the varieties are named "Swamps" — like the mountains, the name carries no zone.
    {
      "id": "tundra_swamp",
      "name": "Swamps",
      "family": "swamp",
      "color": [ 98, 116, 108 ],
      "move_cost": 2,
      "expansion_cost": 4,
      "work_cost_mult": 2.0,
      "icons": [ "tundra_swamp_1.png", "tundra_swamp_2.png", "tundra_swamp_3.png" ],
      // The permafrost bog: nothing but moss and lichen. No tree and no reed survives here.
      "cover_chance": { "none": 60, "tundra_moss": 40 }
    },
    {
      "id": "boreal_swamp",
      "name": "Swamps",
      "family": "swamp",
      "color": [ 88, 112, 96 ],
      "move_cost": 2,
      "expansion_cost": 4,
      "work_cost_mult": 2.0,
      "icons": [ "boreal_swamp_1.png", "boreal_swamp_2.png", "boreal_swamp_3.png" ],
      // The peat bog of the taiga: pines and birches stunted by the cold water, no reed bed.
      "cover_chance": { "none": 45, "swamp_forest_sparse": 45, "swamp_forest": 10 }
    },
    {
      "id": "temperate_swamp",
      "name": "Swamps",
      "family": "swamp",
      "color": [ 90, 120, 80 ],
      "move_cost": 2,
      "expansion_cost": 4,
      "work_cost_mult": 2.0,
      "icons": [ "temperate_swamp_1.png", "temperate_swamp_2.png", "temperate_swamp_3.png" ],
      // The carr of the mild belt: alder and willow standing in the water.
      "cover_chance": { "none": 45, "swamp_forest_sparse": 30, "swamp_forest": 25 }
    },
    {
      "id": "tropical_swamp",
      "name": "Swamps",
      "family": "swamp",
      "color": [ 72, 116, 70 ],
      "move_cost": 2,
      "expansion_cost": 4,
      "work_cost_mult": 2.0,
      "icons": [ "tropical_swamp_1.png", "tropical_swamp_2.png", "tropical_swamp_3.png" ],
      // The warm swamp is a reed bed: the papyrus field (data/resources/plants/technical_plants.json)
      // grows on its reeds, and it is the only swamp where they do.
      "cover_chance": { "none": 25, "swamp_forest_sparse": 10, "swamp_forest": 15, "reeds": 50 }
    },

    // --- THE RELIEF OUTSIDE THE CLIMATE ---------------------------------------------------
    // The water, the marsh and the deserts keep their own records: they are not a variety of
    // a plain and their vegetation comes from their own cover_chance.
    {
      "id": "lake",
      "name": "Freshwater Lake",
      "color": [ 66, 129, 180 ],
      "move_cost": 999,
      "expansion_cost": 6,
      "work_cost_mult": 1.0,
      "icons": [ "lake_1.png", "lake_2.png" ],
      // A direct source of fresh water: a hex of this type (and its neighbours)
      // gives the water_access scheme the status "direct" without any
      // technology being researched. The flag is currently also set on the
      // cover "oasis" — new fresh water sources only need to be given this
      // field, no code change is required.
      "fresh_water_source": true,
      "cover_chance": { "none": 100 }
    },
    // --- THE COASTAL WETLANDS: the marsh of every belt ------------------------------------
    // A marsh is a waterlogged coastal strip, placed after the Voronoi by the post-processing
    // (_apply_marshes and SeaManager). Like the swamp, it is a family: the post-processing sets
    // the family name "marsh" and the climate turns it into the variety of its belt.
    //
    // The cold marsh is a frozen bare mudflat; the warm marsh is a reedy shore. Both are named
    // "Marsh" — the climate is read from what grows in it, not from the name.
    {
      "id": "cold_marsh",
      "name": "Marsh",
      "family": "marsh",
      "color": [ 80, 100, 70 ],
      "move_cost": 2,
      "expansion_cost": 3,
      "work_cost_mult": 1.5,
      "icons": [ "cold_marsh_1.png", "cold_marsh_2.png", "cold_marsh_3.png" ],
      // The frozen marsh: no reed survives here.
      "cover_chance": { "none": 100 }
    },
    {
