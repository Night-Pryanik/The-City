      "id": "tundra_plain",
      "name": "Tundra, Plain",
      "family": "plain",
      "color": [ 178, 190, 192 ],
      "move_cost": 1,
      "expansion_cost": 2,
      "icons": [ "tundra_plain_1.png", "tundra_plain_2.png", "tundra_plain_3.png" ]
    },
