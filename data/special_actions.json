{
  "special_actions": [
    {
      "id": "clear_forest",
      "name": "Clear Forest",
      "action_type": "cover",
      "icon": "clear_forest.png",
      "source_cover": [ "forest", "sparse_forest" ],
      "result_cover": "none",
      "work_cost": 22,
      "unlock_tech": "wood_processing"
    },
    {
      // Универсальное действие «Собрать ресурс» для ЛЮБЫХ одноразовых ресурсов
      // (дикоросы, самородки металлов и т.п.). Применимость определяется НЕ
      // полем target_resource, а флагом «одноразовости» ресурса на гексе:
      //   - у ресурса improved_by == null (не разрабатывается улучшением);
      //   - у ресурса есть непустое produces (есть что собрать);
      //   - ресурс виден игроку (MapHelpers.is_resource_revealed).
      // Выход продукции при сборе берётся из поля produces ресурса
      // (число или [min, max]) — см. main_map.gd, ветка action_type == "forage".
      // После сбора ресурс исчезает с карты (tile.resource = null).
      "id": "forage_resource",
      "name": "Forage Resource",
      "action_type": "forage",
      "icon": "new_resource.png",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Снос улучшения. На гексе с разведением (crop_bred) также сбрасывает
      // crop_bred, чтобы гекс снова стал пустым (см. docs.md, раздел
      // «Разведение животных и растений (схема crop_bred)»). Природный
      // tile.resource при сносе НЕ трогается.
      "id": "demolish_improvement",
      "name": "Demolish Improvement",
      "action_type": "demolish",
      "icon": "demolish.svg",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Осушение болот и маршей: превращает их в равнину (action_type "terrain").
      // source_terrains — список типов местности, к которым применимо действие.
      // Стоимость значительная — 3x строительства фермы
      "id": "drain_water",
      "name": "Drain Water",
      "action_type": "terrain",
      "icon": "drain_swamp.png",
      "source_terrains": [ "swamp", "marsh" ],
      "result_terrain": "plain",
      "work_cost": 24,
      "unlock_tech": "irrigation"
    },
    {
      // Дорога, которую строит ИГРОК — до указанного гекса (action_type "road").
      // Отдельный тип действия, потому что это единственное спецдействие,
      // которое НЕ меняет содержимое гекса, а строит участок дорожной сети
      // ГОРОДА: от ближайшей уже построенной дороги до целевого гекса
      // (стандартный алгоритм road_manager.build_road_from — кратчайший путь
      // по суше до ближайшего подключённого гекса сети города, вода
      // непроходима).
      //
      // Стоимость work_cost — БАЗА ЗА ОДИН НОВЫЙ УЧАСТОК (гекс) трассы.
      // Итог — сумма баз по всем новым участкам, НЕ умножение на их число:
      // у каждого участка своя цена, потому что своя местность и своя
      // дальность от города. Итоговую цену собирает
      // main_map.get_road_cost_breakdown (он же — единый источник для превью
      // и для реального запуска проекта), а цену ОДНОГО участка считает
      // MapHelpers.get_road_step_work_cost.
      //
      // Множители к участку применяются, и в этом принципиальный сдвиг.
      // Раньше дальность НЕ учитывалась с формулировкой «дальность уже
      // отражена длиной трассы». Пока дорога была одной покупкой, это было
      // верно: игрок платил за длину и не видел, что внутри. Теперь каждый
      // участок — отдельная стройка на отдельном гексе, и участок в 10 гексов
      // от города стоит столько же, сколько соседний с городом, хотя это
      // та же работа с тем же грузом в 10 раз дальше.
      //
      //   · work_cost_mult (terrains.json) — сложность МЕСТНОСТИ: в горах и
      //     болотах дороже. Планировщик сам обходит трудную местность, когда
      //     есть обходной путь, поэтому дорога через горы — это как раз
      //     случай «обойти нельзя», а не наказание за неудачный маршрут;
      //   · расстояние от города — свой коэффициент в game_balance.json
      //     (road_distance_cost_modifier_per_hex), отдельный от улучшений,
      //     потому что множится на длину трассы;
      //   · «Колесо» и «Математика» — как и у улучшений.
      //
      // Отдельной надбавки за ДЛИНУ трассы нет: длинная дорога строится
      // дольше потому, что участков больше, а не за счёт штрафа.
      //
      // Тот же тип действия используется и на гексе ГОРОДКА: там цель — не
      // сам гекс, а ближайшая дорога в КОЛЬЦЕ ВЛИЯНИЯ городка, то есть
      // дорожная сеть этого городка. Такое соединение открывает торговлю
      // (см. town_manager.is_trade_available).
      "id": "build_road",
      "name": "Build Road",
      "action_type": "road",
      "icon": "road.svg",
      "result_terrain": "dont_change",
      "work_cost": 10
    }
  ]
}
