{
  "special_actions": [
    {
      "id": "clear_forest",
      "name": "Вырубка леса",
      "action_type": "cover",
      "icon": "clear_forest.png",
      "source_cover": [ "forest", "sparse_forest" ],
      "result_cover": "none",
      "work_cost": 22,
      "unlock_tech": "wood_processing"
    },
    {
      // Универсальное действие «Собрать ресурс» для ЛЮБЫХ одноразовых ресурсов
      // (дикоросы, самородки металлов и т.п.). Применимость определяется НЕ
      // полем target_resource, а флагом «одноразовости» ресурса на гексе:
      //   - у ресурса improved_by == null (не разрабатывается улучшением);
      //   - у ресурса есть непустое produces (есть что собрать);
      //   - ресурс виден игроку (MapHelpers.is_resource_revealed).
      // Выход продукции при сборе берётся из поля produces ресурса
      // (число или [min, max]) — см. main_map.gd, ветка action_type == "forage".
      // После сбора ресурс исчезает с карты (tile.resource = null).
      "id": "forage_resource",
      "name": "Собрать ресурс",
      "action_type": "forage",
      "icon": "new_resource.png",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Снос улучшения. На гексе с разведением (crop_bred) также сбрасывает
      // crop_bred, чтобы гекс снова стал пустым (см. docs.md, раздел
      // «Разведение животных и растений (схема crop_bred)»). Природный
      // tile.resource при сносе НЕ трогается.
      "id": "demolish_improvement",
      "name": "Снести улучшение",
      "action_type": "demolish",
      "icon": "demolish.svg",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Осушение болот и маршей: превращает их в равнину (action_type "terrain").
      // source_terrains — список типов местности, к которым применимо действие.
      // Стоимость значительная — 3x строительства фермы
      "id": "drain_water",
      "name": "Осушение болот",
      "action_type": "terrain",
      "icon": "drain_swamp.png",
      "source_terrains": [ "swamp", "marsh" ],
      "result_terrain": "plain",
      "work_cost": 24,
      "unlock_tech": "irrigation"
    }
  ]
}
