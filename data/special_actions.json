{
  "special_actions": [
    {
      "id": "clear_forest",
      "name": "Clear Forest",
      "action_type": "cover",
      "icon": "clear_forest.png",
      "source_cover": [ "forest", "sparse_forest" ],
      "result_cover": "none",
      "work_cost": 22,
      "unlock_tech": "wood_processing"
    },
    {
      // The universal action "Gather resource" for ANY one-off resources
      // (foraged food, native metal nuggets, etc.). Applicability is determined
      // NOT by the target_resource field but by the "one-off" flag of the
      // resource on the hex:
      //   - the resource has improved_by == null (it is not extracted by an improvement);
      //   - the resource has a non-empty produces (there is something to gather);
      //   - the resource is visible to the player (MapHelpers.is_resource_revealed).
      // The production output on gathering is taken from the produces field
      // of the resource (a number or [min, max]) — see main_map.gd, the
      // action_type == "forage" branch.
      // After gathering, the resource disappears from the map (tile.resource = null).
      "id": "forage_resource",
      "name": "Forage Resource",
      "action_type": "forage",
      "icon": "new_resource.png",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Demolishing an improvement. On a hex with breeding (crop_bred) it also
      // resets crop_bred, so that the hex becomes empty again (see docs.md, the
      // section "Breeding animals and plants (crop_bred scheme)"). The natural
      // tile.resource is NOT touched on demolition.
      "id": "demolish_improvement",
      "name": "Demolish Improvement",
      "action_type": "demolish",
      "icon": "demolish.svg",
      "result_terrain": "dont_change",
      "work_cost": 5
    },
    {
      // Draining swamps and marshes: turns them into a plain (action_type "terrain").
      // source_terrains — the list of terrain types the action applies to.
      // The cost is significant — 3x the cost of a farm
      "id": "drain_water",
      "name": "Drain Water",
      "action_type": "terrain",
      "icon": "drain_swamp.png",
      "source_terrains": [ "swamp", "marsh" ],
      "result_terrain": "plain",
      "work_cost": 24,
      "unlock_tech": "irrigation"
    },
    {
      // The road that the PLAYER builds — up to the specified hex (action_type "road").
      // A separate action type, because this is the only special action
      // that does NOT change the contents of the hex, but builds a segment of the
      // CITY's road network: from the nearest already built road to the target hex
      // (the standard road_manager.build_road_from algorithm — the shortest path
      // over land to the nearest connected hex of the city network, water
      // is impassable).
      //
      // The work_cost cost — the BASE FOR ONE NEW SEGMENT (hex) of the route.
      // The total is the sum of the bases over all new segments, NOT a
      // multiplication by their number: each segment has its own price, because
      // it has its own terrain and its own
      // distance from the city. The total price is assembled by
      // main_map.get_road_cost_breakdown (which is also the single source for the preview
      // and for the actual launch of the project), and the price of ONE segment is
      // computed by MapHelpers.get_road_step_work_cost.
      //
      // Multipliers per segment are applied, and that is a fundamental shift.
      // Previously the distance was NOT taken into account with the wording
      // "the distance is already reflected in the length of the route". While the
      // road was a single purchase, that was
      // true: the player paid for the length and did not see what was inside.
      // Now each segment is a separate construction on a separate hex, and a
      // segment 10 hexes
      // from the city costs the same as the one next to the city, even though it
      // is the same work with the same load 10 times further away.
      //
      //   · work_cost_mult (terrains.json) — the difficulty of the TERRAIN: in the
      //     mountains and swamps it is more expensive. The planner itself avoids
      //     difficult terrain when there is an alternative route, so a road through
      //     the mountains is exactly the "cannot go around" case, and not a
      //     punishment for an unlucky route;
      //   · distance from the city — its own coefficient in game_balance.json
      //     (road_distance_cost_modifier_per_hex), separate from improvements,
      //     because it is multiplied by the length of the route;
      //   · "Wheel" and "Mathematics" — just as for improvements.
      //
      // THE SEGMENT PRICE BASE DOES NOT LIVE HERE but in data/roads.json (the
      // work_cost field of the road level entry): a segment belongs to a level,
      // and the cost/speed of a level are properties of that level, not of this
      // action. That is why build_road has no work_cost field any more: a copy
      // of the same number in two files would go out of sync at the first balance
      // edit. The segment price is taken by
      // MapHelpers.get_road_step_work_cost(road_level, …) from GameData.
      //
      // There is no separate surcharge for the LENGTH of a route: a long road
      // takes longer to build because it has more segments, not because of a
      // penalty.
      //
      // The same action type is used on a TOWN hex as well: there the target is
      // not the hex itself but the nearest road in the INFLUENCE RING of the
      // town, that is, the road network of that town. Such a connection opens
      // trade (see town_manager.is_trade_available).
      "id": "build_road",
      "name": "Build Road",
      "action_type": "road",
      "icon": "road.svg",
      "result_terrain": "dont_change"
    }
  ]
}
