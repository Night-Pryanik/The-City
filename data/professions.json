{
  // Профессии рабочих на улучшениях карты.
  //
  // Терминология:
  //   * Профессия — «метка» жителя, занятого на улучшении. Метка ставится
  //     АВТОМАТИЧЕСКИ при назначении рабочего и снимается при увольнении.
  //     Игрок не управляет метками вручную — профессия определяется
  //     улучшением, на которое назначен рабочий.
  //   * Городские работники (TownsfolkManager, рецепты зданий) — вне
  //     системы профессий; их метки не нужны и здесь не описываются.
  //
  // Связь с улучшениями:
  //   У каждого улучшения (data/improvements.json) может быть поле
  //   "profession" — id профессии, которая на нём работает. Если поле
  //   отсутствует — профессии у улучшения нет. Улучшение, помеченное полем
  //   "no_worker": true (инфраструктурное, например пристань), рабочих
  //   не требует вовсе: их нельзя на него назначить.
  //
  // Потребление ресурсов профессией:
  //   Описывается НЕ здесь, а в данных ресурсов:
  //   * основной вариант — реестр data/consumption.json, записи вида
  //     { "resource": "<id>|@<группа>", "profession": ["<id>"], "amount": N,
  //       "interval": S, "production_bonus": B }.
  //     Ключ "@<группа>" ссылается на группу продуктов из
  //     data/product_groups.json — потребляется любой подходящий продукт
  //     из группы (например, "@boats" — «Лодки» для рыбака).
  //   * устаревший вариант для одиночных случаев — поле "consumption" у
  //     продукта (data/products/*.json): { "profession": ["<id>"], "amount": N,
  //     "interval": S, "production_bonus": B }.
  //   production_bonus — прибавка к множителю производства (1.0 = без бонуса),
  //   пока требуемое количество ресурса есть на складе. Если ресурса
  //   не хватает — улучшение НЕ останавливается, а просто откатывается
  //   к базовому множителю (без бонуса). См. docs.md, раздел
  //   «Профессии и потребление ресурсов».
  //
  // Формат записи:
  //   id           — уникальный строковый идентификатор (snake_case).
  //   name         — именительный падеж, ед.ч.: «Фермер», «Шахтёр».
  //                  Используется в UI: «Профессия: Фермер».
  //   icon         — имя файла иконки (как у продуктов/улучшений).
  //   description  — короткое описание для подсказок (опционально).
  "professions": [
    // ПСЕВДО-ПРОФЕССИЯ — вершина иерархии: покрывает ВСЕХ жителей города —
    // и свободных, и занятых (в том числе рабочих на улучшениях с другими
    // профессиями и городских работников в зданиях). Ни одно улучшение не
    // должно ссылаться на неё (поле "profession" в improvements.json) —
    // иначе «профессия» появится в UI у рабочего. Потребление записывается
    // на неё в data/consumption.json и списывается ПОГОЛОВНО: amount в
    // правиле — на ОДНОГО жителя, суммарное списание за тик =
    // amount * total_population. "pseudo" — маркер, что это не метка
    // рабочего, а счётчик населения.
    {
      "id": "all",
      "name": "Все жители",
      "description": "Псевдо-профессия: охватывает всё население города, включая занятых жителей.",
      "pseudo": true
    },
    {
      "id": "farmer",
      "name": "Фермер",
      "icon": "profession_farmer.png",
      "description": "Возделывает поля, ухаживает за посевами."
    },
    {
      "id": "herder",
      "name": "Скотовод",
      "icon": "profession_herder.png",
      "description": "Присматривает за стадом, следит за поголовьем."
    },
    {
      "id": "miner",
      "name": "Шахтёр",
      "icon": "profession_miner.png",
      "description": "Добывает руду и минералы под землёй."
    },
    {
      "id": "quarryman",
      "name": "Каменотёс",
      "icon": "profession_quarryman.png",
      "description": "Добывает камень в открытых карьерах."
    },
    {
      "id": "beekeeper",
      "name": "Пчеловод",
      "icon": "profession_beekeeper.png",
      "description": "Следит за ульями, собирает мёд."
    },
    {
      "id": "vinedresser",
      "name": "Виноградарь",
      "icon": "profession_vinedresser.png",
      "description": "Возделывает виноградник, собирает урожай."
    },
    {
      "id": "potter",
      "name": "Гончар",
      "icon": "profession_potter.png",
      "description": "Копает и сортирует глину для обжига."
    },
    {
      "id": "planter",
      "name": "Плантатор",
      "icon": "profession_planter.png",
      "description": "Возделывает технические и пряные культуры."
    },
    {
      "id": "tar_collector",
      "name": "Смолокур",
      "icon": "profession_tar_collector.png",
      "description": "Собирает и выпаривает природную смолу."
    },
    {
      "id": "soda_extractor",
      "name": "Содовщик",
      "icon": "profession_soda_extractor.png",
      "description": "Добывает соду из природных отложений."
    },
    {
      "id": "fisherman",
      "name": "Рыбак",
      "icon": "profession_fisherman.png",
      "description": "Ловит рыбу с лодок на водоёмах с пристанью."
    },
    {
      "id": "lumberjack",
      "name": "Лесоруб",
      "icon": "profession_lumberjack.png",
      "description": "Рубит деревья на лесной делянке и заготавливает древесину."
    }
  ]
}
