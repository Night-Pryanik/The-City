{
  // The climate zones of the map: what a pair of the climate axes turns the relief into.
  //
  // A zone is not a thing the player ever sees as such: the player reads the TERRAIN of a hex, and
  // the name of the terrain already says which belt it belongs to — "Boreal, Plain", "Tropical,
  // Hills" (data/terrains/terrains.json). The zone only decides which variety of the relief stands
  // where and what grows on it.
  //
  // The axes (see map_config.json → "climate"):
  //   temperature — the belts from the poles to the equator: cold, mild, subtropical, tropical.
  //                 The belts are strictly ordered, so two hexes of the same latitude are never
  //                 more than one belt apart;
  //   humidity    — large wet and dry regions that do not follow the latitudes: they lie anywhere,
  //                 curve and surround each other.
  //
  // The fields of a zone:
  //   terrain      — the variety of every relief family of the zone (plain, hill, mountain). The
  //                  family is the field "family" of a terrain record (data/terrains/terrains.json);
  //   cover_chance — the vegetation of the zone. It applies to all three families of the zone, so
  //                  a taiga mountain and a taiga plain share the same woods. The covers of the
  //                  water, the wetlands and the deserts are NOT taken from here: those terrains
  //                  keep their own cover_chance;
  //   deserts      — true: the sandy and rocky deserts may stand in the zone. Everywhere else
  //                  they are levelled into the plain of the zone, so that a sandy desert never
  //                  appears in the taiga. The field is absent = false.
  //
  // Every pair (temperature, humidity) must have a zone: the generator looks the zone up by the
  // pair and falls back to another zone of the same temperature belt if it finds none
  // (data_validator reports the gap as zone_axes).
  "climate_zones": [
    // --- THE COLD BELT: the boreal zone ---------------------------------------------------
    {
      "id": "boreal_dry",
      "temperature": "cold",
      "humidity": "dry",
      "terrain": { "plain": "boreal_plain", "hill": "boreal_hill", "mountain": "boreal_mountain" },
      "cover_chance": { "none": 90, "taiga_sparse": 10 }
    },
    {
      "id": "boreal_wet",
      "temperature": "cold",
      "humidity": "wet",
      "terrain": { "plain": "boreal_plain", "hill": "boreal_hill", "mountain": "boreal_mountain" },
      "cover_chance": { "none": 30, "taiga": 45, "taiga_sparse": 25 }
    },

    // --- THE MILD BELT: the steppe and the prairie -----------------------------------------
    {
      "id": "steppe",
      "temperature": "mild",
      "humidity": "dry",
      "terrain": { "plain": "steppe_plain", "hill": "steppe_hill", "mountain": "steppe_mountain" },
      "cover_chance": { "none": 88, "temperate_dry_forest": 4, "temperate_dry_forest_sparse": 8 }
    },
    {
      "id": "prairie",
      "temperature": "mild",
      "humidity": "wet",
      "terrain": { "plain": "prairie_plain", "hill": "prairie_hill", "mountain": "prairie_mountain" },
      "cover_chance": { "none": 40, "temperate_rainforest_sparse": 25, "temperate_rainforest": 35 }
    },

    // --- THE SUBTROPICAL BELT: the savanna -------------------------------------------------
    {
      "id": "savanna_dry",
      "temperature": "subtropical",
      "humidity": "dry",
      "terrain": { "plain": "savanna_plain", "hill": "savanna_hill", "mountain": "savanna_mountain" },
      "cover_chance": { "none": 90, "temperate_dry_forest_sparse": 10 },
      "deserts": true
    },
    {
      "id": "savanna_wet",
      "temperature": "subtropical",
      "humidity": "wet",
      "terrain": { "plain": "savanna_plain", "hill": "savanna_hill", "mountain": "savanna_mountain" },
      "cover_chance": { "none": 55, "temperate_rainforest_sparse": 35, "temperate_rainforest": 10 }
    },

    // --- THE TROPICAL BELT: the tropical plain ---------------------------------------------
    {
      "id": "tropical_dry",
      "temperature": "tropical",
      "humidity": "dry",
      "terrain": { "plain": "tropical_plain", "hill": "tropical_hill", "mountain": "tropical_mountain" },
      "cover_chance": { "none": 82, "tropical_dry_forest": 6, "tropical_dry_forest_sparse": 12 },
      "deserts": true
    },
    {
      "id": "tropical_wet",
      "temperature": "tropical",
      "humidity": "wet",
      "terrain": { "plain": "tropical_plain", "hill": "tropical_hill", "mountain": "tropical_mountain" },
      "cover_chance": { "none": 22, "tropical_rainforest": 50, "tropical_rainforest_sparse": 28 }
    }
  ]
}
