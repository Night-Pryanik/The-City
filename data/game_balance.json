{
  // Game balance: numeric constants moved out of the code.
  //
  // The fields live in the "game_balance" object (the top-level key of the file,
  // like "consumption" in data/consumption.json or "map_config" in
  // data/map_config.json). Loaded via data_loader.gd -> GameData.game_balance.
  //
  // Fields:
  //   initial_treasury                 — the coins in the city treasury at the
  //                                      start of a new game (the "treasury"
  //                                      field in CityData).
  //   town_initial_treasury            — the coins in the treasury of EVERY
  //                                      town at the moment it is generated.
  //                                      The town treasury lives in the town
  //                                      record ("treasury") and changes only
  //                                      through TownManager.add_town_treasury /
  //                                      spend_town_treasury, which notify the
  //                                      town window (town_treasury_changed).
  //   base_tax_per_citizen             — the base tax: the coins that EVERY
  //                                      citizen of the city pays into the
  //                                      treasury per one simulation tick
  //                                      (SIMULATION_TICK = 1 sec).
  //                                      Collection is CityData.collect_taxes()
  //                                      from CityData.do_tick(); the sum per
  //                                      tick = base_tax_per_citizen ×
  //                                      total_population
  //                                      (see docs.md, "City treasury and
  //                                      internal market", "Taxes").
  //   internal_market_price_multiplier — the share of the base price of a good
  //                                      (price from
  //                                      data/products/*.json) at which
  //                                      the internal market buys the good from
  //                                      the city. The treasury profit per unit =
  //                                      round(price * multiplier );
  //                                      the treasury is always an integer.
  //                                      Profit is credited
  //                                      only for units actually written off on
  //                                      consumption (see docs.md,
  //                                      "City treasury and internal market").
  //   distance_cost_modifier_per_hex   — the UNIVERSAL distance modifier:
  //                                      an addition to the cost of an action
  //                                      per each hex of distance from the city
  //                                      (a share; 0.25 = +25% per hex).
  //                                      It is applied to the costs of ONLY
  //                                      those builds where the player picks
  //                                      the hex themselves:
  //                                        · the labour for building improvements
  //                                          and special actions (MapHelpers.
  //                                          get_improvement_work_cost);
  //                                        · the coins for scouting a chunk and
  //                                          claiming a chunk (expansion_manager).
  //                                      The multiplier formula for a hex:
  //                                      1 + distance × value
  //                                      (see MapHelpers.get_distance_mult).
  //   road_distance_cost_modifier_per_hex — THE SAME, but for a road SEGMENT
  //                                      that the player builds. A separate
  //                                      field on purpose: the formula
  //                                      is applied to every segment
  //                                      of the route, so the distance multiplier
  //                                      is multiplied by the length of the road.
  //                                      At 0.25 segment #20 would cost 6 times
  //                                      more than the first one, and a road to a
  //                                      distant town would become unaffordable.
  //                                      0.1 gives a readable series 1.1, 1.2,
  //                                      …, 2.0 (MapHelpers.
  //                                      get_road_distance_mult). The terrain
  //                                      multiplier (work_cost_mult from
  //                                      terrains.json) and the tech modifiers
  //                                      are applied to a segment just as they
  //                                      are to an improvement. There is no
  //                                      separate surcharge for the LENGTH of a
  //                                      route: a long road takes longer to
  //                                      build, because it has more segments,
  //                                      not because of a penalty.
  //                                      Tech modifiers (for example "Wheel",
  //                                      target = "improvement_distance_cost")
  //                                      are layered on top for both improvements
  //                                      and the road.
  //   scouting_cost_per_hex            — the base price of scouting one hex in
  //                                      treasury coins. The price of a chunk =
  //                                      the sum of the prices of its
  //                                      hexes, each with its own distance
  //                                      modifier (see docs.md, "Cost of
  //                                      scouting (coins from the treasury)").
  //   expansion_cost_per_hex           — the base price of claiming one hex in
  //                                      treasury coins (written off immediately
  //                                      at the start of the claim). The labour
  //                                      is counted SEPARATELY and is NOT scaled
  //                                      by distance: that is the expansion_cost
  //                                      of the terrain in
  //                                      data/terrains.json.
  //   town_storage_limit               — the CAPACITY of the warehouse of one town,
  //                                      in units PER product id. The limit is per
  //                                      good, and not the total of the warehouse:
  //                                      one town can hold 1000 wheat AND 1000
  //                                      silk at the same time. A product that has
  //                                      reached the limit simply stops taking more
  //                                      units (the overflow is discarded, the
  //                                      production itself is not lost forever —
  //                                      it resumes being stored as soon as the
  //                                      units are sold).
  //                                      Applied by
  //                                      TownEconomy.store_production.
  //   town_storage_initial_min /
  //   town_storage_initial_max         — the bounds of the STARTING stock of one
  //                                      product in the warehouse of one town: a
  //                                      town is generated with a random integer in
  //                                      [min, max] units of EVERY product of its
  //                                      sell_pool. The value is derived from
  //                                      (the town id, the product id), and not
  //                                      from the global RNG: it must be the same
  //                                      on every recalculation of the pools.
  //   town_tick_ticks                  — how many ticks of the common simulation
  //                                      are in ONE tick of the simulation of a
  //                                      town. 4 means that a town accumulates
  //                                      its production 4 times slower than the
  //                                      city does (TownManager.TOWN_TICK_SECONDS
  //                                      = town_tick_ticks ×
  //                                      CityData.SIMULATION_TICK).
  "game_balance": {
    "initial_treasury": 100,
    "town_initial_treasury": 1000,
    "base_tax_per_citizen": 2,
    "internal_market_price_multiplier": 1.0,
    "distance_cost_modifier_per_hex": 0.25,
    "road_distance_cost_modifier_per_hex": 0.1,
    "scouting_cost_per_hex": 3,
    "expansion_cost_per_hex": 5,
    "town_storage_limit": 1000,
    "town_storage_initial_min": 100,
    "town_storage_initial_max": 500,
    "town_tick_ticks": 4
  }
}