{
  // Game balance: numeric constants moved out of the code.
  //
  // The constants live in the "game_balance" object (the top-level key of the file,
  // like "consumption" in data/consumption.json or "map_config" in
  // data/map_config.json). Loaded via data_loader.gd -> GameData.game_balance.
  //
  // The object is grouped into blocks by the system that owns the constants:
  //   city       — the treasury of the player's city and its internal market;
  //   craft      — the price of a good with additional ingredients;
  //   breeding   — the livestock: the seed herd of a new herd, the breeding cycle and the core the slaughterhouse keeps;
  //   expansion  — the costs of extending the city's territory on the map;
  //   towns      — the economy of the towns (their treasury, warehouse and trade).
  //
  // The blocks are a layout of THIS FILE only. On load they are flattened into one
  // flat dictionary, so every constant is read by its own name
  // (GameData.game_balance.get("base_tax_per_citizen")) — a constant is addressed
  // directly, never through its block. The names are therefore unique across the
  // whole file. See data_loader._flatten_balance_blocks.
  "game_balance": {
    // --- CITY: the treasury and the internal market of the player's city ---
    "city": {
      // initial_treasury — the coins in the city treasury at the start of a new game
      //                    (the "treasury" field in CityData).
      "initial_treasury": 100,

      // base_tax_per_citizen — the base tax: the coins that EVERY citizen of the city
      //                        pays into the treasury per one simulation tick
      //                        (SIMULATION_TICK = 1 sec). Collection is
      //                        CityData.collect_taxes() from CityData.do_tick();
      //                        the sum per tick = base_tax_per_citizen ×
      //                        total_population (see docs.md, "City treasury and
      //                        internal market", "Taxes").
      "base_tax_per_citizen": 2,

      // internal_market_price_multiplier — the share of the base price of a good
      //                        (price from data/products/*.json) at which the internal
      //                        market buys the good from the city. The treasury profit
      //                        per unit = round(price * multiplier); the treasury is
      //                        always an integer. Profit is credited only for units
      //                        actually written off on consumption (see docs.md,
      //                        "City treasury and internal market").
      "internal_market_price_multiplier": 1.0,

      // food_per_citizen — the food (the staple ration) that ONE eating citizen
      //                        writes off per simulation tick (SIMULATION_TICK = 1 sec)
      //                        from the food pool. The founder (the first citizen) does
      //                        not eat, so the city demand = (total_population - 1) ×
      //                        food_per_citizen. It is a balance constant that is
      //                        reset to this default in CityData.setup() on a new game;
      //                        a loaded save overrides it (SaveManager.apply_loaded_data).
      "food_per_citizen": 10,

      // food_for_new_settler — the food paid once for the birth of a new citizen.
      //                        Balance constant reset to this default in CityData.setup()
      //                        on a new game; a loaded save overrides it.
      "food_for_new_settler": 1000
    },

    // --- CRAFT: the price of a good with an additional ingredient ---
    //
    // A good with an addition ("Wool Clothes (+Purple)") is priced as the sum of its parts, each
    // at the quality of its own units: the base good at the level of the base and the addition
    // at the level of the addition (GameData.get_price_with_extra). The material of the
    // addition is paid for in full — there is no premium on top of it, so a cheap dye never
    // makes a garment worth more than the dye itself is worth.
    "craft": {
      // craft_extra_synergy — the coefficient that makes a good with an addition worth MORE than
      //                        its parts sold separately: 0.15 = x1.15 of the sum of the parts.
      //                        It pays for the craft itself and for the fact that the addition
      //                        cannot be sold twice. Without it such a good is exactly worth the
      //                        base plus the addition, and the player has no reason to attach
      //                        anything but for the population's demand.
      "craft_extra_synergy": 0.15
    },

    // --- BREEDING: the livestock, the seed herd for a breeding on an empty hex ---
    "breeding": {
      // livestock_breeding_cost — how many heads of the live animal product
      //                        (live_cows, live_pigs, ...) the breeding of a NEW herd
      //                        on an empty hex takes from the city storage
      //                        (CityData.take_livestock_for). The same number of heads
      //                        is granted when a species is domesticated for the first
      //                        time — the build on a natural herd (main_map
      //                        ._apply_improvement) — so the first herd of every
      //                        species starts for free, and the further herds must be
      //                        bought in a town or grown.
      //
      //                        The same number is the breeding core the slaughterhouse
      //                        never touches: the last livestock_breeding_cost heads
      //                        always stay in the storage, so the automatic butchering
      //                        cannot extinct the species (only selling them all away
      //                        or demolishing every pasture can).
      "livestock_breeding_cost": 10,
      // breeding_cycle_multiplier — the length of one breeding cycle in units of
      //                        time_to_mature (see the animal raw resources). A pasture
      //                        breeds one batch of heads (the live_* value in its
      //                        produces) per cycle: for the cattle it is 1 × 60 s = 60 s.
      //                        The batch holds 4 heads per second of time_to_mature:
      //                        with the multiplier 1 the pasture yields 4 heads per
      //                        second, which is what one slaughterhouse butchers (20
      //                        heads into 120 units of meat every 5 s). The cycle is
      //                        never shorter than time_to_mature: the herd matures only
      //                        when the fill time reaches time_to_mature, and the
      //                        milk/wool/eggs flow waits for that.
      "breeding_cycle_multiplier": 1
    },

    // --- EXPANSION: the cost of extending the city's territory over the map ---
    "expansion": {
      // distance_cost_modifier_per_hex — the UNIVERSAL distance modifier: an addition
      //                        to the cost of an action per each hex of distance from
      //                        the city (a share; 0.25 = +25% per hex). It is applied
      //                        to the costs of ONLY those builds where the player
      //                        picks the hex themselves:
      //                          · the labour for building improvements and special
      //                            actions (MapHelpers.get_improvement_work_cost);
      //                          · the coins for scouting a chunk and claiming a
      //                            chunk (expansion_manager).
      //                        The multiplier formula for a hex: 1 + distance × value
      //                        (see MapHelpers.get_distance_mult).
      "distance_cost_modifier_per_hex": 0.25,

      // road_distance_cost_modifier_per_hex — THE SAME, but for a road SEGMENT that
      //                        the player builds. A separate field on purpose: the
      //                        formula is applied to every segment of the route, so
      //                        the distance multiplier is multiplied by the length of
      //                        the road. At 0.25 segment #20 would cost 6 times more
      //                        than the first one, and a road to a distant town would
      //                        become unaffordable. 0.1 gives a readable series 1.1,
      //                        1.2, …, 2.0 (MapHelpers.get_road_distance_mult). The
      //                        terrain multiplier (work_cost_mult from terrains.json)
      //                        and the tech modifiers are applied to a segment just as
      //                        they are to an improvement. There is no separate
      //                        surcharge for the LENGTH of a route: a long road takes
      //                        longer to build, because it has more segments, not
      //                        because of a penalty. Tech modifiers (for example
      //                        "Wheel", target = "improvement_distance_cost") are
      //                        layered on top for both improvements and the road.
      "road_distance_cost_modifier_per_hex": 0.1,

      // scouting_cost_per_hex — the base price of scouting one hex in treasury coins.
      //                        The price of a chunk = the sum of the prices of its
      //                        hexes, each with its own distance modifier (see docs.md,
      //                        "Cost of scouting (coins from the treasury)").
      "scouting_cost_per_hex": 3,

      // expansion_cost_per_hex — the base price of claiming one hex in treasury coins
      //                        (written off immediately at the start of the claim).
      //                        The labour is counted SEPARATELY and is NOT scaled by
      //                        distance: that is the expansion_cost of the terrain in
      //                        data/terrains.json.
      "expansion_cost_per_hex": 5
    },

    // --- LOGISTICS: how the road carries the goods to the city ---
    //
    // Every route (from an improvement, or from a town once its purchases exist)
    // has TWO independent characteristics, and they come from different places:
    //   · the FLOW RATE (units/sec) — the throughput of the route. It is the average
    //     max_speed of the segments (data/roads.json), computed by
    //     road_manager.find_route_to_city; it is NOT stored here;
    //   · the TRANSIT DELAY (sec) — how long a shipped load travels before it starts
    //     arriving. It is the length of the route in hexes × transit_time_per_hex,
    //     and this coefficient is the single knob for it.
    // The two are independent: a longer route is slower, but a better road is not
    // automatically shorter.
    "logistics": {
      // transit_time_per_hex — the seconds a load spends on the road per one hex of
      //                        the route. The transit delay of a route =
      //                        (the number of its segments, see route.length) × this
      //                        value. 0.2 gives 2 seconds for a 10-hex route.
      //                        Read by DeliveryManager.get_transit_time_per_hex().
      "transit_time_per_hex": 0.2
    },

    // --- TOWNS: the treasury, the warehouse and the daily trade of a town ---
    //
    // A town is a small settlement on the map, not the player's city. It lives on
    // its own, slower clock (town_tick_ticks), and every town tick it makes one
    // trade per product of its warehouse — it either BUYS (the stock grows) or
    // SELLS (the stock shrinks). The trade is TownEconomy.tick_trade.
    "towns": {
      // town_initial_treasury — the coins in the treasury of EVERY town at the moment
      //                    it is generated. The town treasury lives in the town record
      //                    ("treasury") and changes only through
      //                    TownManager.add_town_treasury / spend_town_treasury, which
      //                    notify the town window (town_treasury_changed).
      "town_initial_treasury": 1000,

      // town_tick_ticks — how many ticks of the common simulation are in ONE tick of
      //                    the simulation of a town. 4 means that a town trades 4 times
      //                    slower than the city ticks (TownManager.get_town_tick_seconds
      //                    = town_tick_ticks × CityData.SIMULATION_TICK).
      "town_tick_ticks": 4,

      // town_storage_limit — the CAPACITY of the warehouse of one town, in units PER
      //                    product id. The limit is per good, and not the total of the
      //                    warehouse: one town can hold 1000 wheat AND 1000 silk at
      //                    the same time. A product that has reached the limit stops
      //                    taking more units (the overflow is discarded and resumes
      //                    being stored as soon as the units are sold).
      "town_storage_limit": 1000,

      // town_storage_initial_min / town_storage_initial_max — the bounds of the
      //                    STARTING stock of one product in the warehouse of one town:
      //                    a town is generated with a random integer in [min, max]
      //                    units of EVERY product of its sell_pool. The value is
      //                    derived from (the town id, the product id), and not from
      //                    the global RNG, because it must be the same on every
      //                    recalculation of the pools. The range defines what "a
      //                    healthy reserve" means for a town: its midpoint is the
      //                    COMFORT level the trade pulls the stock back toward
      //                    (TownEconomy.get_trade_comfort), so there is no separate
      //                    constant for it.
      "town_storage_initial_min": 100,
      "town_storage_initial_max": 500,

      // The size of a day's trade is what moves the number in the town window; the
      // whole point is that it moves BOTH ways, like a real market. A town is its own
      // little market: it trades in small lots and is not bound by the game-wide "10"
      // floor that recipes and player purchases use (all amounts in data/crafts and
      // data/consumption are at least 10, but a town lot of 3..6 is normal — the
      // player reads the STOCK, he never measures a town trade against a recipe).

      // town_trade_min / town_trade_max — the bounds of an ORDINARY trade: a flat draw
      //                    from [min, max] units. This is the town's day-to-day
      //                    movement; it is NOT the comfort level that anchors the
      //                    direction of the trade (see town_storage_initial_min).
      "town_trade_min": 3,
      "town_trade_max": 15,

      // town_trade_bulk_chance — the chance that a day's trade is a BULK trade (a
      //                    caravan) rather than an ordinary one. On such a day the
      //                    drawn lot is multiplied by a factor from
      //                    [town_trade_bulk_min, town_trade_bulk_max]: the heavy tail
      //                    that occasionally fills or drains the warehouse, and what
      //                    makes the curve look alive.
      // town_trade_bulk_min / town_trade_bulk_max — the bounds of that multiplier.
      "town_trade_bulk_chance": 0.06,
      "town_trade_bulk_min": 3,
      "town_trade_bulk_max": 8,

      // town_trade_inertia — how strongly the direction of the last trade repeats.
      //                    Without it the sign would flip every day and the stock
      //                    would look like pure noise; with it, rises and falls come in
      //                    short runs.
      "town_trade_inertia": 0.65,

      // town_trade_bias_strength — how strongly a shortage tilts the town toward
      //                    BUYING and a full warehouse toward SELLING. This is the
      //                    anchor that keeps the stock around the comfort level:
      //                    without any bias the stock is a pure random walk and half
      //                    the towns end up pinned at zero or at the cap forever.
      "town_trade_bias_strength": 0.6,

      // --- The daily trade of the treasury ---
      //
      // The treasury breathes with the same market as the warehouse: the daily
      // purchases and sales of goods a town makes move the coins the other way —
      // a purchase drains the treasury, a sale fills it. The movement follows the
      // same law as the daily trade of the stock (roll_trade_size, roll_trade_sign,
      // see TownEconomy.tick_treasury), so the number in the window looks alive for
      // the same reason. The comfort level it is pulled back toward is the STARTING
      // treasury of a town (town_initial_treasury), so a town that has spent its
      // coins down recovers toward the level it was born with.
      //
      // town_treasury_trade_min / town_treasury_trade_max — the bounds of an
      //                    ORDINARY treasury trade, in coins. Money moves in bigger
      //                    numbers than units of goods, so these are larger than the
      //                    town_trade_* bounds.
      "town_treasury_trade_min": 20,
      "town_treasury_trade_max": 120,

      // town_treasury_bulk_chance — the chance that a day's treasury trade is a BULK
      //                    one (a caravan settlement); on such a day the drawn sum is
      //                    multiplied by a factor from
      //                    [town_treasury_bulk_min, town_treasury_bulk_max].
      "town_treasury_bulk_chance": 0.06,
      "town_treasury_bulk_min": 3,
      "town_treasury_bulk_max": 8,

      // town_treasury_inertia — how strongly the direction of the last treasury trade
      //                    repeats. Without it the direction would flip every day and
      //                    the sum would look like pure noise.
      "town_treasury_inertia": 0.65,

      // town_treasury_bias_strength — how strongly an empty treasury tilts the town
      //                    toward SELLING goods (income) and a full one toward BUYING
      //                    (spending). This is the anchor that keeps the sum around
      //                    the comfort level.
      "town_treasury_bias_strength": 0.6,

      // town_treasury_recovery_threshold — the share of the comfort level below which
      //                    the treasury counts as "close to zero". There the daily
      //                    direction is forced toward income and the size of the step is
      //                    capped by town_treasury_recovery_step, so the treasury drifts
      //                    back up toward the starting value slowly instead of snapping
      //                    to it. That is what keeps a buyer for the player's goods:
      //                    a town that has spent its coins down does not stay empty-handed.
      // town_treasury_recovery_step — the cap on a recovery day's step, as a share of
      //                    the comfort level.
      "town_treasury_recovery_threshold": 0.15,
      "town_treasury_recovery_step": 0.02,

      // --- A standing contract: what a town can actually supply ---
      //
      // The output of a town is virtual and has no building behind it: a town has no
      // population limit and can raise as many workshops as it needs, so its rate is a
      // design number and NOT "one building of every kind". It is bounded from above by
      // the size of its own warehouse — the CEILING below is the average starting stock
      // of a good read as a rate. A town that keeps a warehouse of a good can also
      // restock it in a second; nothing it does can outrun that, whatever the order.
      //
      // A town serves an order up to its COMFORT rate for free: the whole draw is
      // covered, the warehouse is untouched and only breathes with the daily trade.
      // Asked for more, the town strains — its output follows the order but always falls
      // short of it, and the shortfall drains the stock. The larger the order, the faster
      // the stock falls behind, until the warehouse runs dry and the contract is torn.
      // That is how a player can still buy a town out, and why a huge contract tears in
      // minutes while a modest one holds for a long time.

      // town_contract_comfort — the share of the ceiling every town serves a standing
      //                    contract with for FREE (0.1 -> 30 units/sec on the current
      //                    data). Up to it the warehouse is not touched at all; above it
      //                    the strain and the drain begin.
      "town_contract_comfort": 0.1,

      // town_contract_drain — the units per SECOND the warehouse of a town loses when the
      //                    order is TWICE its comfort rate. It is the anchor of the drain
      //                    curve: the town keeps up less and less, and this is the
      //                    shortfall at the first doubling of the order.
      // town_contract_drain_curve — the exponent of that curve. The drain rises as
      //                    ((order - comfort) / comfort) ^ curve, so a sub-unity exponent
      //                    makes it grow fast at first and then flatten: a contract just
      //                    over the comfort rate still takes many minutes to empty a
      //                    warehouse, while a huge one empties it in seconds. The drain
      //                    never overtakes the draw, so a town never supplies less than
      //                    its comfort rate, and its supply never exceeds the ceiling.
      "town_contract_drain": 0.75,
      "town_contract_drain_curve": 0.3
    }
  }
}
