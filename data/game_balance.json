{
  // Игровой баланс: числовые константы, вынесенные из кода.
  //
  // Поля лежат в объекте "game_balance" (верхний ключ файла, как "consumption"
  // в data/consumption.json или "map_config" в data/map_config.json).
  // Загружается через data_loader.gd -> GameData.game_balance.
  //
  // Поля:
  //   initial_treasury                 — монеты в казне города при старте новой
  //                                      игры (поле "treasury" в CityData).
  //   internal_market_price_multiplier — доля базовой цены товара (price из
  //                                      data/products/*.json), по которой
  //                                      внутренний рынок покупает товар у
  //                                      города. Прибыль казны за единицу = 
  //                                      round(price * multiplier );
  //                                      казна всегда целочисленная.
  //                                      Прибыль начисляется
  //                                      только за реально списанные при
  //                                      потреблении единицы (см. docs.md,
  //                                      «Казна города и внутренний рынок»).
  //   distance_cost_modifier_per_hex   — УНИВЕРСАЛЬНЫЙ модификатор дальности:
  //                                      прибавка к стоимости действия за
  //                                      каждый гекс расстояния от города
  //                                      (доля; 0.25 = +25% за гекс).
  //                                      Применяется ко ВСЕМ зависящим от
  //                                      расстояния стоимостям сразу:
  //                                        · труд строительства улучшений и
  //                                          спецдействий (MapHelpers.
  //                                          get_improvement_work_cost);
  //                                        · монеты за разведку чанка и
  //                                          освоение чанка (expansion_manager).
  //                                      Формула множителя для гекса:
  //                                      1 + расстояние × значение
  //                                      (см. MapHelpers.get_distance_mult).
  //                                      Тех-модификаторы (например, «Колесо»,
  //                                      target = "improvement_distance_cost")
  //                                      накладываются сверху только там, где
  //                                      это уместно, и само значение не меняют.
  //   scouting_cost_per_hex            — базовая цена разведки одного гекса в
  //                                      монетах казны. Цена чанка = сумма цен
  //                                      гексов, каждая со своим модификатором
  //                                      дальности (см. docs.md, «Стоимость
  //                                      разведки (монеты из казны)»).
  //   expansion_cost_per_hex           — базовая цена освоения одного гекса в
  //                                      монетах казны (списывается сразу при
  //                                      старте освоения). Труд считается
  //                                      ОТДЕЛЬНО и расстоянием НЕ масштабируется:
  //                                      это expansion_cost террейна в
  //                                      data/terrains.json.
  "game_balance": {
    "initial_treasury": 100,
    "internal_market_price_multiplier": 1.0,
    "distance_cost_modifier_per_hex": 0.25,
    "scouting_cost_per_hex": 3,
    "expansion_cost_per_hex": 5
  }
}