{
  // The configuration of the world map.
  // The dimensions of the hex map (in hexes).
  "map_config": {
    "map_rows": 60,        // How many rows of hexes the whole map has (the world height)
    "map_cols": 60,        // How many columns of hexes the whole map has (the world width)

    // The starting Influence Ring (the city territory at the start of the game).
    "start_ring_rows": 7,   // The height of the starting ring in hexes
    "start_ring_cols": 9,   // The width of the starting ring in hexes

    // The width of the Region around the Influence Ring for the FIRST era (in hexes).
    // The width of the Region for subsequent eras is taken from data/eras.json
    // (the "region_width" field of each era, read on the era transition).
    // The Region is the area around the ring in which chunks can be BOUGHT
    // (claimed). Scouting is not limited to the Region ONLY after the technology
    // "Cartography" is researched (scouts can be sent to any point reachable
    // by scrolling the map — including town territory and the fog of war).
    // Before it, scouting is available only in the unexplored part of the Region,
    // and hexes in the fog of war are not available for hovering and clicking.
    // Unexplored hexes beyond Ring+Region are not drawn (fog of war).
    "region_width": 2,

    // --- The configuration of terrain types for generating Voronoi centres ---
    // For each terrain type:
    //   density         — the share of centres of that type (sum ≈ 1.0). Optional.
    //   target_cluster  — the average cluster size in hexes (an upper bound:
    //                     the number of centres cannot be more than area / target_cluster).
    //                     If not set — the bound is not applied.
    // The global target_cluster (below) is a fallback value for the types that
    // do not have their own target_cluster in terrain_config.
    "target_cluster": 22,
    "terrain_config": {
      "plain":        { "density": 0.30, "target_cluster": 22 },
      "hill":         { "density": 0.25, "target_cluster": 30 },
      "lake":         { "density": 0.10, "target_cluster": 50 },
      "mountain":     { "density": 0.20, "target_cluster": 25 },
      "swamp":        { "density": 0.05, "target_cluster": 5 },
      "sandy_desert": { "density": 0.05, "target_cluster": 5 },
      "rocky_desert": { "density": 0.05, "target_cluster": 5 }
    },

  // --- Sea generation ---
  // The sea does NOT take part in the Voronoi algorithm (it is not in terrain_config).
  // It is generated as a mask BEFORE Voronoi and is re-applied on top of
  // the Voronoi result so as not to be overwritten.
  // The field name prefix tells which mode it belongs to:
  //   edge_*  — is read only in the "edge" mode;
  //   noise_* — is read only in the "noise" mode;
  //   no prefix — common to all modes.
  "sea": {
    // --- Common (all modes) ---
    "mode": "edge",              // "none" (no sea) | "edge" (coastal strips with bays) | "noise" (elevation field)
    "sides": [1, 2],             // the range [min, max] of the number of map edges with sea; [0,0] — no sea
    "beach": true,               // true: land adjacent to the sea becomes a beach (beach)
    "max_sea_depth": 28,         // the limit of the sea depth from the map edge (in hexes), so that the sea does not "eat" the map

    // --- Only the "edge" mode ---
    "edge_width_min": 0,           // the minimum strip width (in hexes); 0 allows the coast to break into bays
    "edge_width_max": 45,          // the maximum strip width (in hexes)
    "edge_envelope_strength": 0.5, // bays: 0 = a solid strip from edge to edge, ~0.7 = a bay in the middle of a side and land at the edges, 1 = only the peak of the bay
    // --- Islands in the seas (only the "edge" mode) ---
    // Islands are groups of land hexes "grown" inside the sea. The number
    // is adjusted to the area of the sea: target = sea_area * edge_island_density,
    // and then the spread randi_range(0, target + 1). In a small sea (low
    // area) this often gives 0 islands, in a big one — it may give many.
    // The size of a particular island (in hexes) is random in the range [min, max].
    "edge_islands_enabled": true,   // enable island generation in the seas
    "edge_island_size": [1, 5],    // the range of island sizes in hexes: [minimum, maximum]
    "edge_island_density": 0.03,  // base density: target = sea_area * density (and then random 0..target+1)
    "edge_island_min_distance": 3,  // the minimum distance between islands (in hexes), so that they do not stick together
    "edge_island_max_attempts": 60,// the max attempts to find a place for the seed point (protection against an infinite loop)

    // --- Only the "noise" mode ---
    "noise_sea_level": 0.0,      // the "land/sea" threshold: elevation <= threshold = sea
    "noise_strength": 0.35,      // the amplitude of the elevation noise (raggedness of the coast, islands)
    "noise_edge_gradient": 1,    // continentality: 0 = islands everywhere, 1 = sea strictly at the edges
    "noise_city_bump": 0.5,      // the elevation "hill" around the city: guarantees the starting continent
    "noise_city_bump_radius": 8  // the radius of guaranteed land around the city (in hexes)
  },

    // --- River generation ---
    // Main rivers: the source in the mountains, the mouth in a lake or the sea.
    // They do not intersect each other.
    // Tributaries: the source in the mountains (or hills, if there are few mountains),
    // flowing into the main rivers or into other tributaries (a confluence point).
    "num_main_rivers": 3,      // The number of main rivers
    "num_tributaries": 5,      // The number of tributaries
    "min_river_length": 8,     // The minimum length of a main river (in path points)
    "min_tributary_length": 4, // The minimum length of a tributary (in path points)

    // --- Town (small settlement) generation ---
    // Towns appear at the start of the game and can later be used
    // for trade. There is no functionality at the moment: on a town hex
    // building any improvement and any special action is forbidden.
    //
    // The town territory (the influence ring, radius 3) NEVER overlaps
    // the player's starting area — the Influence Ring + the Region of the 1st era:
    // its hexes are cut out of the ring, and its resources are not counted as
    // points of attraction (see player_start_area in scripts/town_manager.gd).
    //
    // Priorities (the algorithm goes through them strictly from top to bottom,
    // see the details in scripts/town_manager.gd):
    //   1) multi_resource — the hex has 2+ DIFFERENT resources within
    //      MAX_ATTRACTION_DISTANCE (3 hexes), that is, "a cluster of resources in
    //      the vicinity"; a resource within a radius of 3 from which a town
    //      already stands does not participate in the count (one cluster does not
    //      pull two towns);
    //   2) strategic — a strategic resource (resource.strategic == true)
    //      within a radius of 3 hexes;
    //   3) river — a hex along which a river flows (river_edges is non-empty);
    //   4) lake_coast — a land hex adjacent to a lake (terrain == "lake");
    //   5) sea_coast — a sea coast (terrain == "beach").
    // The water priorities are strictly single hexes: a town by the water is
    // placed DIRECTLY on a river hex / a lake shore / a beach, and not "within
    // 3 hexes of the water".
    //
    // The priorities are NOT equal in value. STEP 0: the base is the topmost
    // priority that has a valid hex ANYWHERE on the map (a full walk, without
    // giving up after N random attempts). The generator moves on to the
    // next priority ONLY when the current one is exhausted across the whole map,
    // so a town will not settle by a lake/sea while there is a free place with
    // a cluster of resources.
    // STEPS 1..N: local refinement — within a radius of REFINEMENT_RADIUS
    // (2 hexes) from the current hex, a hex is searched for that satisfies ALL
    // the priorities already earned AND the new one. If none is found — the
    // priority is skipped, the position does not
    // change, and the cascade goes to the next priority.
    // The secondary priority (TERRAIN_PREFERENCE in town_manager.gd): after
    // the cascade, the position is softly refined by terrain type — plain/sand →
    // hills → deserts → swamps/marshes → mountains, keeping the earned
    // priorities.
    "num_towns": 16             // The number of towns on the map
  }
}