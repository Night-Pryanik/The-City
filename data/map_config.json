{
  // Конфигурация карты мира.
  // Размеры гексовой карты (в гексах).
  "map_config": {
    "map_rows": 60,        // Сколько рядов гексов во всей карте (высота мира)
    "map_cols": 60,        // Сколько колонок гексов во всей карте (ширина мира)

    // Стартовое Кольцо Влияния (территория города на момент начала игры).
    "start_ring_rows": 7,   // Высота стартового кольца в гексах
    "start_ring_cols": 9,   // Ширина стартового кольца в гексах

    // Ширина Региона вокруг Кольца Влияния.
    // Регион — видимая/исследуемая область вокруг кольца.
    // Всё за пределами (Кольцо + Регион) скрыто туманом войны.
    "region_width": 2,

    // --- Конфигурация типов местности для генерации центров Вороного ---
    // Для каждого типа местности:
    //   density         — доля центров этого типа (сумма ≈ 1.0). Приоритетна.
    //   target_cluster  — средний размер кластера в гексах (ограничение сверху:
    //                     число центров не может быть больше area / target_cluster).
    //                     Если не задан — ограничение не применяется.
    // Глобальный target_cluster (ниже) — запасное значение для типов, у которых
    // не задан свой target_cluster в terrain_config.
    "target_cluster": 22,
    "terrain_config": {
      "plain":    { "density": 0.40, "target_cluster": 22 },
      "hill":     { "density": 0.25, "target_cluster": 30 },
      "lake":     { "density": 0.10, "target_cluster": 50 },
      "mountain": { "density": 0.20, "target_cluster": 25 },
      "swamp":    { "density": 0.05, "target_cluster": 5 }
    },

  // --- Генерация морей ---
  // Море НЕ участвует в алгоритме Вороного (не входит в terrain_config).
  // Оно генерируется как маска ДО Вороного и повторно применяется поверх
  // результата Вороного, чтобы не быть перезаписанным.
  // Префикс имени поля говорит, какому режиму оно принадлежит:
  //   edge_*  — читается только в режиме "edge";
  //   noise_* — читается только в режиме "noise";
  //   без префикса — общее для всех режимов.
  "sea": {
    // --- Общие (все режимы) ---
    "mode": "edge",              // "none" (морей нет) | "edge" (прибрежные полосы с заливами) | "noise" (поле высот)
    "sides": [1, 2],             // диапазон [min, max] количества сторон света с морем; [0,0] — моря нет
    "beach": true,               // true: суша, соседняя с морем, становится пляжем (beach)
    "max_sea_depth": 28,         // предел глубины моря от края карты (в гексах), чтобы море не «съедало» карту

    // --- Только режим "edge" ---
    "edge_width_min": 0,           // минимальная ширина полосы (в гексах); 0 позволяет берегу прерываться в заливы
    "edge_width_max": 45,          // максимальная ширина полосы (в гексах)
    "edge_envelope_strength": 0.5, // заливы: 0 = сплошная полоса от края до края, ~0.7 = залив в центре стороны и суша у краёв, 1 = только пик залива

    // --- Только режим "noise" ---
    "noise_sea_level": 0.0,      // порог «суша/море»: elevation <= порога = море
    "noise_strength": 0.35,      // амплитуда шума высот (рваность берега, острова)
    "noise_edge_gradient": 1,    // континентальность: 0 = острова везде, 1 = море строго у краёв
    "noise_city_bump": 0.5,      // «холм» высоты вокруг города: гарантирует стартовый континент
    "noise_city_bump_radius": 8  // радиус гарантированной суши вокруг города (в гексах)
  },

    // --- Генерация рек ---
    // Главные реки: исток в горах, устье в озере или море. Не пересекаются друг с другом.
    // Притоки: исток в горах (или холмах, если гор мало), впадают в главные
    // реки или в другие притоки (точка слияния).
    "num_main_rivers": 3,      // Количество главных рек
    "num_tributaries": 5,      // Количество притоков
    "min_river_length": 8,     // Минимальная длина главной реки (в точках пути)
    "min_tributary_length": 4  // Минимальная длина притока (в точках пути)
  }
}