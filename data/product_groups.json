{
// The product groups that can be used in craft recipes instead of single products
// Do not confuse this with groups.json: that file holds groups for bonuses,
// this one is a registry of groups used in recipes and in accounting for
// consumption by professions
//
// The optional "icon" field of a group — the icon file name for the resource
// card on the "Trade" tab. If it is NOT specified, the icon of the
// FIRST member of the group that has its own icon set is taken (the old order).
// A separate icon is needed where the first member is not representative of
// the group: for "Alcohol" it is beer, although the group is primarily grain
// beverages.
  "product_groups": [
    {
      "id": "millable_grains",
      "name": "Millable Grains",
