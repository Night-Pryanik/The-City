{
    // Степени качества ресурсов.
    // Уровни перечислены от худшего к лучшему.
    // value — числовой вес для расчёта взвешенного среднего при производстве.
    // stars — текстовое представление звёздами (для карты и тултипов).
    // spawn_weight — относительный вес при случайном определении качества
    //               ресурса при спавне на карте.
    // price_multiplier — МНОЖИТЕЛЬ цены единицы товара этого качества
    //               (1.0 = базовая цена без изменения). Именно умножается,
    //               а не прибавляется: одинаковая прибавка в монетах
    //               сломала бы шкалу цен (корм за 1 и украшение за 140
    //               получили бы +30% против +0.2%).
    //               Значения подобраны так, чтобы соседние уровни давали
    //               РАЗНЫЕ итоговые цены: при 1.30/1.75/2.30 уровни
    //               различаются у 265 из 268 товаров (сливаются только
    //               три товара за 1 монету). Более близкие значения
    //               (1.15/1.35/1.60) сливались у 43 товаров — качество
    //               переставало стоить разницы.
    //               Итоговая цена округляется до ЦЕЛОГО числа монет
    //               (см. GameData.get_price_breakdown_for_quality).
    "quality_levels": [
        {
            "id": "common",
            "name": "Обычное",
            "value": 1,
            "stars": "★",
            "spawn_weight": 50,
            "price_multiplier": 1.0
        },
        {
            "id": "fine",
            "name": "Хорошее",
            "value": 2,
            "stars": "★★",
            "spawn_weight": 30,
            "price_multiplier": 1.3
        },
        {
            "id": "exceptional",
            "name": "Исключительное",
            "value": 3,
            "stars": "★★★",
            "spawn_weight": 15,
            "price_multiplier": 1.75
        },
        {
            "id": "perfect",
            "name": "Превосходное",
            "value": 4,
            "stars": "★★★★",
            "spawn_weight": 5,
            "price_multiplier": 2.3
        }
    ],
    // Приоритеты выбора сырья для производства (кнопка в панели здания).
    // best — сначала самое лучшее качество, worst — сначала худшее, random — случайно.
    "priority_default": "best",
    "priority_options": ["best", "worst", "random"],
    "priority_names": {
        "best": "Лучшее качество",
        "worst": "Худшее качество",
        "random": "Случайно"
    }
}